# Foundry environment configuration
# Copy to .env and customize.

# HTTP listener
FOUNDRY_HOST=0.0.0.0
FOUNDRY_PORT=3000
FOUNDRY_PUBLIC_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://foundry:foundry@postgres:5432/foundry
DATABASE_MAX_CONNECTIONS=10

# Sessions (REQUIRED in production — generate with `openssl rand -base64 48`)
SESSION_SECRET=change-me-this-must-be-at-least-32-bytes-of-secret-material-please
SESSION_COOKIE_SECURE=false  # Set to true behind HTTPS

# Feature A (US-W05b) — Ed25519 machine-token keypair. REQUIRED on every
# verifier (MACHINE_TOKEN_PUBLIC_KEYS); the signing key only on an issuing
# binary. Generate with:
#   openssl genpkey -algorithm ed25519 -out priv.pem && openssl pkey -in priv.pem -pubout -out pub.pem
# PEM newlines encoded as literal \n (normalized at boot).
# MACHINE_TOKEN_PUBLIC_KEYS is comma-separated (newest first) for rotation.
MACHINE_TOKEN_PUBLIC_KEYS=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAwtFPs8Jcuncc+E7dXqG/oolI3P6Hamrpd8zVKPvRmg0=\n-----END PUBLIC KEY-----
MACHINE_TOKEN_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIK82aJdks5jZYdUK6HN6tiWmq7nU4yrILbQSibZdvMYK\n-----END PRIVATE KEY-----

# Observability
RUST_LOG=info,foundry_app=debug,foundry_store=debug,foundry_auth=debug
METRICS_PORT=9090

# Limits
FILE_UPLOAD_MAX_MB=10

# SMTP (optional — leave SMTP_HOST unset to disable email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=foundry@example.com
# SMTP_PASS=changeme
# SMTP_FROM=foundry@example.com
