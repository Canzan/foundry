/target
**/*.rs.bk
Cargo.lock.bak
.env
.env.local
*.swp
.DS_Store
/coverage

# Local tooling state (machine-specific; should not be shared)
/.dual-graph/
/.nwave/des/logs/

# cargo-mutants output directory (transient feature-scoped mutation runs)
/mutants.out/
/mutants.out.old/

# Operator-local K8s secret (copied from foundry-secret.example.yaml
# and filled with real values; must never be committed).
/deploy/k8s/foundry-secret.yaml

# SBOM dropped by the release workflow when run locally with act.
/sbom.spdx.json
.dual-graph/
