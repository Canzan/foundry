#!/usr/bin/env bash
# The public probe an examiner uses to look at Foundry's pages: one throwaway
# Foundry, seeded into a named state, asked for pages as named signed-in viewers.
#
#     scripts/examine-foundry states | viewers
#     scripts/examine-foundry start secrets-key-no-slack
#     scripts/examine-foundry start secrets-key-no-slack --before
#     scripts/examine-foundry get Priya workspace/integrations
#     scripts/examine-foundry post Priya admin/instance/integrations/secrets-key
#     scripts/examine-foundry slack-info
#     scripts/examine-foundry slack-event planted url-verification
#     scripts/examine-foundry start slack-app-saved --replicas 2
#     scripts/examine-foundry slack-event --replica 2 rotated url-verification
#     scripts/examine-foundry time-passes 11m
#     scripts/examine-foundry slack-posting not-answering
#     scripts/examine-foundry mail
#     scripts/examine-foundry rotate-secrets
#     scripts/examine-foundry new-issue Lena backend/identity-platform "Rotate the bind password"
#     scripts/examine-foundry gate --file crates/foundry-app/templates/base.html my-head.html
#     scripts/examine-foundry suite us-cts-04 --file crates/foundry-app/templates/base.html my-head.html
#     scripts/examine-foundry stop
#
# Paths may be written with or without the leading slash; under
# `nwdes examine probe` they must be written without it, since nwdes admits only
# workspace-relative arguments.
#
# On macOS everything runs in the Lima VM (default local-dev, or
# FOUNDRY_TEST_VM), never on the Mac's Docker: `start` syncs and builds the
# release binary through scripts/test-in-lima.sh, then boots a postgres:16-alpine
# container and the binary in the VM. On Linux it runs on this host. `start`
# holds ~/test.lock while it builds and boots, as test-in-lima.sh does.
#
# The probe may run with a restricted cwd and environment (nwdes gives it only
# PATH, LANG and a scratch HOME and TMPDIR, and starts it through /dev/fd/N), so
# the script finds the repo from the file it was started from, and the real home
# from the password database.
#
# `--before` boots the release binary built from the commit named in
# .nwave/examine-baseline instead of the checkout, from its own clone and target
# directory in the VM, so a page can be compared before and after a change.
#
# To add a state: add a line to `states_table` and a `seed_<name>` function (dashes
# become underscores) that runs after the shared people, team and project exist.
# A state whose server needs settings of its own also gets `env_<name>`, which
# prints them as KEY=VALUE lines.
#
# A Slack double (a small Python server in the VM) runs with every probe
# instance, and Foundry is given SLACK_API_BASE_URL and SLACK_AUTHORIZE_URL
# pointing at it, so Add to Slack, the channel picker and posting work offline.
# Slack's client is not held to the outbound address rules, so plain http on
# loopback is accepted. The same server is the mail double: Foundry sends mail
# through its email_api provider to $SLACK_BASE/mail/send, and `mail` prints it.
#
# `start <state> --replicas 2` also runs a second Foundry process (replica 2) on
# the same database, data directory and settings, on port 18484; `get`, `post`
# and `slack-event` take `--replica 2` to ask it instead of replica 1.
#
# `time-passes <N>m|<N>h` moves the time stamps of the Slack app waiting for its
# confirm and of every waiting delivery N minutes or hours into the past, as if
# that time had passed: no supported setting changes Foundry's clock.
#
# A state may restart a replica with other settings once it is seeded (a
# different FOUNDRY_INSTANCE_KEY, an instance key file it cannot read): each
# replica's own settings are kept in $STATE_DIR/env-<N>, so `rotate-secrets`
# runs `foundry doctor rotate-secrets` with replica 1's settings as they are now.
#
# `new-issue <viewer> <team>/<project> <title>` creates an issue as that viewer
# through the project's public issue form, as the seeds do, and prints where
# the browser lands; its deliveries then show in slack-info and mail.
#
# `browser <viewer> [options] <step>...` opens the page in a real headless
# Chromium in the VM, signed in as that viewer, driven over its DevTools port by
# node (both are in the VM's tools). Each viewer keeps one browser profile, so a
# choice a page stores in the browser is still there at the next `browser` call,
# as in the same browser on another day; `--fresh` starts that viewer's browser
# from nothing, and `stop` removes every profile. Steps run in order:
#   go <path>, reload           open or reload a page and wait for it to load
#   watch-go <path>, watch-reload  the same, and report the layout of the
#                               navigation, main and complementary landmarks
#                               before each frame
#                               the browser painted, with the paint timings
#   look                        what the page shows now: page and viewport width,
#                               horizontal scroll, boxes that scroll sideways or
#                               reach past the right edge, landmarks, buttons with
#                               their names and states, links in navigation, focus
#   key <Tab|Shift+Tab|Enter|Space|Escape>   a real key press, then the focus
#   tab-order <N>               N Tab presses, with the focus after each
#   click <name>                a real pointer click on the one visible button or
#                               link with that accessible name (exact, else a part)
#   hover <name>                move the real pointer onto the one visible button
#                               or link with that name, then the words it paints
#   sign-in                     sign this viewer in through the sign-in form, by
#                               typing, in this same profile (so what the browser
#                               stored before is kept)
#   width <px>                  change the viewport width
# A link in navigation and the focus show `current=<value>` when the page marks
# them with aria-current. The focus line also lists the words the control
# paints: each with its box, and `seen` when the point at its centre shows it
# (a word clipped away or covered is `not seen`). A signed-in cookie from the
# probe goes into the profile only when the profile holds none of that name,
# so a session the browser ended or made itself is kept.
# Options: --width <px> (1280), --height <px> (800), --phone (a touch phone
# viewport, 390x844 unless --width or --height is given), --js off (JavaScript disabled for the whole run), --slow <N> (CPU
# slowed N times), --fresh.
#
# `gate` and `suite` look at the candidate as a contributor does. Each copies
# the candidate (without target/ and .git/) to a staged tree in the VM, puts
# each `--file <repo path> <your file>` in place there, prints what the staged
# tree changes, then runs the project gate (`cargo xtask check-arch --root
# <staged tree>`) or the acceptance scenarios with that one tag, written with or
# without its @ (built from the
# staged tree, in release, then run) and prints the exit status and the output.
# A `--file` may replace crates/foundry-app/templates/base.html or add or
# replace a file under crates/foundry-app/static/, nothing else. With no
# `--file` the staged tree is the candidate as it is. The checkout is never
# changed. `suite` builds in its own target directory in the VM, which `stop`
# keeps as a cache: the first build takes about 20 minutes; a later run that
# changes the head rebuilds only what the files change, about 8 minutes in all,
# so give its call a 10-minute limit.
#
# No subcommand reads the caller's stdin: main runs with stdin from /dev/null.
set -euo pipefail

PROG=examine-foundry
VM="${FOUNDRY_TEST_VM:-local-dev}"
PUBLIC_URL=https://foundry.example.org
WORKSPACE_NAME="Canzan Labs"
PASSWORD=examine-foundry-password
PORT=18480
METRICS_PORT=18481
PG_PORT=18482
# Replica 2, when `start --replicas 2` asks for it.
PORT_2=18484
METRICS_PORT_2=18485
# The baseline's own clone and target directory, relative to the VM home; the
# probe never builds the baseline in the checkout or in the synced tree.
BEFORE_TREE=examine-foundry-before/repo
PG_IMAGE=postgres:16-alpine
PG_NAME=foundry-examine-pg
# Well-formed fake Slack app values (a client ID is digits.digits, each secret
# 32 lowercase hex): the planted values of the instance-integration-setup stories.
SLACK_ID=6123456789012.7234567890123
SLACK_SECRET=3f9c0a7e5b2d4c18a6e0f7b9d2c4e1a8
SLACK_SIGNING=b7e1d4c9a2f05e3b8c6d1a7f4e9b2c05
# Another well-formed signing secret, for a rotation.
SLACK_SIGNING_ROTATED=4c2e9a7f1b3d5e8c0a6f2d4b9e1c7a35
SLACK_PORT=18483
SLACK_BASE="http://127.0.0.1:$SLACK_PORT"

die() {
  printf '%s: %s\n' "$PROG" "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
usage: examine-foundry start <state> [--before] [--replicas 2]
       examine-foundry get [--replica 2] <viewer> <path>
       examine-foundry post [--replica 2] <viewer> <path> [key=value ...]
       examine-foundry slack-info
       examine-foundry slack-event [--replica 2] <planted|rotated|none|SECRET> [url-verification | app-uninstalled <Slack workspace>]
       examine-foundry slack-posting <answering|not-answering|slow-down>
       examine-foundry time-passes <N>m | <N>h
       examine-foundry mail
       examine-foundry rotate-secrets
       examine-foundry new-issue [--replica 2] <viewer> <team>/<project> <title>
       examine-foundry browser <viewer> [--width px] [--height px] [--phone] [--js off] [--slow N] [--fresh] <step>...
           steps: go <path> | reload | watch-go <path> | watch-reload | look | key <Tab|Shift+Tab|Enter|Space|Escape> | tab-order <N> | click <name> | hover <name> | sign-in | width <px>
       examine-foundry gate [--file <repo path> <your file>]...
       examine-foundry suite <tag> [--file <repo path> <your file>]...
           a --file replaces crates/foundry-app/templates/base.html or a file under crates/foundry-app/static/
           gate takes seconds; suite takes about 8 minutes, so give its call a 10-minute limit
           such as: suite us-cts-04 --file crates/foundry-app/templates/base.html my-head.html
           (us-cts-04 holds the scenario that reads the served head, A chosen dark screen never flashes light)
       examine-foundry stop
       examine-foundry states | viewers
Write each path without its leading slash: admin/instance/integrations, not /admin/instance/integrations.
USAGE
}

states_table() {
  cat <<'STATES'
secrets-key-no-slack	This Foundry made its own instance key file and Priya generated the secrets key; no Slack app is saved and no workspace is connected to Slack or Matrix.
instance-key-no-secrets-key	This Foundry made its own instance key file and has no secrets key yet; nothing is set up for Slack or Matrix.
env-slack-no-secrets-key	Foundry's environment sets the Slack app (SLACK_CLIENT_ID 6123456789012.7234567890123 and its two secrets); this Foundry made its own instance key file and has no secrets key; nothing is connected.
slack-app-saved	This Foundry made its own instance key file, Priya generated the secrets key and saved the Slack app with client ID 6123456789012.7234567890123 on the instance integrations page; no workspace is connected.
slack-connected	As slack-app-saved, and Priya connected Canzan Labs to the Slack workspace Canzan Labs through the saved app (Add to Slack); Lena routed New issue on Identity Platform to #auth-dev, and one issue was created, so one message was delivered.
slack-connected-three	As slack-connected, and Priya also made the workspaces Ops Guild (admin Omar) and Reading Club (admin Rosa) on the instance workspaces page; Omar and Rosa each connected theirs to Slack through the saved app, so 3 workspaces are connected.
env-slack-connected	Foundry's environment sets the Slack app (SLACK_CLIENT_ID 6123456789012.7234567890123); Priya generated the secrets key and connected Canzan Labs to Slack through that app; no app is saved on the instance page.
slack-app-awaiting-confirm	As slack-connected, and Priya made Kai Tanaka (a member of Canzan Labs) a second instance admin on the instance workspaces page; then Priya submitted another Slack app (client ID 6123456789012.8888888888888, both secrets) on the instance integrations page, which now waits for her confirm.
slack-delivery-pending	As slack-connected, then Slack stopped answering Foundry's posts (slack-posting not-answering) and Lena created the issue "Expire the old sessions", so its New issue delivery to #auth-dev waits on the route's history; the route is listed on the project's integrations page, team/backend/project/identity-platform/integrations, which links to its History.
secrets-key-unopenable	Foundry runs with the operator's instance key (FOUNDRY_INSTANCE_KEY); Priya generated the secrets key, saved the Slack app with client ID 6123456789012.7234567890123 and connected Canzan Labs to the Slack workspace Canzan Labs; Canzan Labs also has a Matrix connection to matrix.example.org with a bot token, planted with SQL (Foundry reaches no Matrix homeserver this probe can run); then Foundry restarted with a different FOUNDRY_INSTANCE_KEY, so it cannot open the stored secrets key or its 3 saved credentials, and no running server opens the key.
secrets-key-unopenable-one	Foundry runs with the operator's instance key (FOUNDRY_INSTANCE_KEY); Priya generated the secrets key and saved the Slack app with client ID 6123456789012.7234567890123, and no workspace is connected; then Foundry restarted with a different FOUNDRY_INSTANCE_KEY, so it cannot open the stored secrets key or its 1 saved credential, and no running server opens the key.
secrets-key-unopenable-none	Foundry runs with the operator's instance key (FOUNDRY_INSTANCE_KEY); Priya generated the secrets key and saved nothing under it; then Foundry restarted with a different FOUNDRY_INSTANCE_KEY, so it cannot open the stored secrets key, it holds no saved credential, and no running server opens the key.
secrets-key-unopenable-live-server	As secrets-key-unopenable, but replica 2 (port 18484) was started before that restart and still runs with the instance key that sealed the stored secrets key, so it still opens the key; replica 1, which get and post ask unless told --replica 2, cannot.
instance-key-file-unreadable	This Foundry made its own instance key file; Priya generated the secrets key, saved the Slack app with client ID 6123456789012.7234567890123 and connected Canzan Labs to Slack; then Foundry restarted with no FOUNDRY_INSTANCE_KEY and its instance key file, /tmp/examine-foundry-data/instance.key, replaced by a file that holds no key.
three-credentials-key-opens	Foundry runs with the operator's instance key (FOUNDRY_INSTANCE_KEY); Priya generated the secrets key and saved the Slack app with client ID 6123456789012.7234567890123; Canzan Labs (by Priya) and Ops Guild (admin Omar) are connected to Slack through it; Lena routed New issue on Identity Platform to #auth-dev and one issue was delivered. 3 saved credentials, all of which open. No Matrix connection: Foundry reaches no Matrix homeserver this probe can run.
three-credentials-one-damaged	As three-credentials-key-opens, then the stored sealed credential of Ops Guild's Slack connection was damaged with SQL (one byte of it changed, as disk or database damage would), so it no longer opens; nothing told Foundry, so its pages still read as before, and a replacement's re-seal refuses it.
STATES
}

viewers_table() {
  cat <<'VIEWERS'
Priya	Priya Raman: this Foundry's instance admin and an admin of the Canzan Labs workspace; lead of the teams General and Backend.
Tomás	Tomás Rivera: an admin of the Canzan Labs workspace, not an instance admin; on no team.
Lena	Lena Park: a member of the Canzan Labs workspace, lead of team Backend (project Identity Platform); neither kind of admin.
Omar	Omar Haddad: the admin of the workspace Ops Guild, and nothing else; only in slack-connected-three, three-credentials-key-opens and three-credentials-one-damaged.
Rosa	Rosa Lind: the admin of the workspace Reading Club, and nothing else; only in slack-connected-three.
Kai	Kai Tanaka: a member of the Canzan Labs workspace and this Foundry's second instance admin; on no team; only in slack-app-awaiting-confirm.
signed-out	Nobody signed in.
VIEWERS
}

print_table() {
  "$1" | while IFS=$'\t' read -r name words; do
    printf '%s: %s\n' "$name" "$words"
  done
  echo
  echo "Write each path without its leading slash, such as: get Priya admin/instance/integrations"
  echo "Start a state with --replicas 2 to run a second replica; then get, post and slack-event take --replica 2."
}

state_known() {
  states_table | cut -f1 | grep -qxF -- "$1"
}

# The viewer's key (priya, tomas, lena, signed-out), or nothing.
viewer_key() {
  local lower
  lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    priya | "priya raman") echo priya ;;
    tomás | tomas | "tomás rivera" | "tomas rivera") echo tomas ;;
    lena | "lena park") echo lena ;;
    omar | "omar haddad") echo omar ;;
    rosa | "rosa lind") echo rosa ;;
    kai | "kai tanaka") echo kai ;;
    signed-out | nobody | anonymous) echo signed-out ;;
    *) return 1 ;;
  esac
}

# --------------------------------------------------------------- the host side

# The file this script was started from. Under nwdes it is started as
# /dev/fd/N, so the path behind that descriptor is asked for.
self_path() {
  local fd path
  case "$0" in
    /dev/fd/* | /proc/self/fd/*)
      fd="${0##*/}"
      if [ "$(uname -s)" = Darwin ]; then
        path=$(lsof -a -p "$$" -d "$fd" -Fn 2>/dev/null | sed -n 's/^n//p' | head -n1)
      else
        path=$(readlink -f "/proc/$$/fd/$fd")
      fi
      ;;
    */*) path="$0" ;;
    *) path="${BASH_SOURCE[0]}" ;;
  esac
  [ -n "$path" ] && [ -f "$path" ] || die "cannot find the file this script runs from ($0)"
  (cd "$(dirname "$path")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$path")")
}

real_home() {
  local user
  user=$(id -un)
  case "$user" in *[!A-Za-z0-9._-]*) die "unexpected user name $user" ;; esac
  eval "printf '%s\n' ~$user"
}

# Run this script in the VM: its own text goes in on stdin, so the VM always
# runs the same code as the host, whatever was last synced.
in_vm() {
  local limit="$1" lock="$2"
  shift 2
  local inner
  inner=$(printf '%q ' "$@")
  if [ "$lock" = lock ]; then
    inner="flock -o -w 900 ~/test.lock bash -s -- $inner"
  else
    inner="bash -s -- $inner"
  fi
  # limactl's own warnings are dropped; the probe's errors pass through.
  {
    timeout "$limit" limactl shell --workdir / "$VM" bash -c \
      ". ~/foundry-test-env; ulimit -n 8192; $inner" <"$SELF" 2>&1 1>&3 3>&- |
      { grep -v 'level=warning' >&2 || true; }
  } 3>&1
}

vm_up() {
  command -v limactl >/dev/null || die "limactl is not installed; scripts/test-vm-setup.sh needs it"
  local status
  status=$(timeout 30 limactl list --format '{{.Status}}' "$VM" 2>/dev/null) ||
    die "no Lima VM named $VM; create it with scripts/test-vm-setup.sh"
  if [ "$status" != Running ]; then
    timeout 300 limactl start "$VM" >/dev/null 2>&1 || die "could not start the Lima VM $VM"
  fi
  # Lima can report Running while the VM is dead: ask it something.
  timeout 30 limactl shell --workdir / "$VM" true 2>/dev/null ||
    die "the Lima VM $VM does not answer; restart it with limactl stop $VM && limactl start $VM"
}

host_start() {
  local state="$1" before="$2" replicas="$3" log build tree
  vm_up
  log="$TMPDIR_HOST/examine-foundry-build.log"
  if [ -n "$before" ]; then
    # Synced first, so the VM's history holds the baseline commit.
    build=(bash scripts/examine-foundry __vm build-before "$before" foundry)
    tree="$BEFORE_TREE"
  else
    build=(bash -c 'CARGO_BUILD_JOBS=4 cargo build --release -p foundry-app --bin foundry')
    tree=foundry
  fi
  if ! (cd "$ROOT" && timeout 3600 scripts/test-in-lima.sh "${build[@]}") >"$log" 2>&1; then
    tail -n 20 "$log" >&2
    die "building the release foundry binary in $VM failed (log: $log)"
  fi
  # The tree is relative to the VM home.
  in_vm 900 lock __vm start "$state" "$tree" "$replicas"
}

# The commit .nwave/examine-baseline names.
baseline_commit() {
  local file="$ROOT/.nwave/examine-baseline" commit
  [ -f "$file" ] || die "no .nwave/examine-baseline names the commit --before builds"
  commit=$(tr -d ' \t\r\n' <"$file")
  case "$commit" in
    "" | *[!0-9a-f]*) die ".nwave/examine-baseline holds no commit id" ;;
  esac
  printf '%s\n' "$commit"
}

host_main() {
  local cmd="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$cmd" in
    states) print_table states_table ;;
    viewers) print_table viewers_table ;;
    start)
      local before='' replicas=1 state=''
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --before) before=$(baseline_commit) ;;
          --replicas)
            [ "${2:-}" = 1 ] || [ "${2:-}" = 2 ] || die "--replicas takes 1 or 2"
            replicas="$2"
            shift
            ;;
          -*) die "usage: examine-foundry start <state> [--before] [--replicas 2]" ;;
          *)
            [ -z "$state" ] || die "usage: examine-foundry start <state> [--before] [--replicas 2]"
            state="$1"
            ;;
        esac
        shift
      done
      [ -n "$state" ] || die "usage: examine-foundry start <state> [--before] [--replicas 2] (see: examine-foundry states)"
      state_known "$state" || die "no state named $state (see: examine-foundry states)"
      if [ "$(uname -s)" = Linux ]; then
        local_start "$state" "$before" "$replicas"
      else
        host_start "$state" "$before" "$replicas"
      fi
      ;;
    get | post)
      local replica=1
      if [ "${1:-}" = --replica ]; then
        replica=$(replica_number "${2:-}")
        shift 2
      fi
      [ "$#" -ge 2 ] || die "usage: examine-foundry $cmd [--replica 2] <viewer> <path>$([ "$cmd" = post ] && echo ' [key=value ...]')"
      local viewer
      viewer=$(viewer_key "$1") || die "no viewer named $1 (see: examine-foundry viewers)"
      [ "$cmd" = get ] && [ "$#" -gt 2 ] && die "get takes one path; use post to send fields"
      local path="$2"
      shift 2
      local field
      for field in "$@"; do
        case "$field" in *=*) ;; *) die "a field is key=value, not $field" ;; esac
      done
      run_op 120 "$cmd" "$replica" "$viewer" "$path" "$@"
      ;;
    browser)
      local bw='' bh='' bjs=on bslow=1 bfresh=no bphone=no
      local bviewer=''
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --width | --height | --slow | --js)
            [ "$#" -ge 2 ] || die "$1 needs a value"
            case "$1" in
              --width) bw="$2" ;;
              --height) bh="$2" ;;
              --slow) bslow="$2" ;;
              --js) bjs="$2" ;;
            esac
            shift 2
            ;;
          --phone) bphone=yes && shift ;;
          --fresh) bfresh=yes && shift ;;
          -*) die "no browser option $1" ;;
          *)
            [ -z "$bviewer" ] || break
            bviewer=$(viewer_key "$1") || die "no viewer named $1 (see: examine-foundry viewers)"
            shift
            ;;
        esac
      done
      [ -n "$bviewer" ] || die "usage: examine-foundry browser <viewer> [options] <step>..."
      # A phone is 390x844 unless --width or --height says otherwise.
      if [ "$bphone" = yes ]; then
        bw="${bw:-390}" bh="${bh:-844}"
      else
        bw="${bw:-1280}" bh="${bh:-800}"
      fi
      case "$bw$bh" in *[!0-9]*) die "--width and --height take pixels" ;; esac
      [ "$bw" -ge 200 ] && [ "$bw" -le 3000 ] && [ "$bh" -ge 200 ] && [ "$bh" -le 3000 ] ||
        die "--width and --height take 200 to 3000"
      case "$bjs" in on | off) ;; *) die "--js takes on or off" ;; esac
      case "$bslow" in [1-9] | 1[0-9] | 20) ;; *) die "--slow takes 1 to 20" ;; esac
      [ "$#" -ge 1 ] || die "browser needs at least one step, such as: browser Priya go workspace look"
      run_op 200 browser "$bviewer" "$bw" "$bh" "$bjs" "$bslow" "$bfresh" "$bphone" "$@"
      ;;
    gate | suite) host_contributor "$cmd" "$@" ;;
    stop) run_op 120 stop ;;
    slack-info) run_op 60 slack-info ;;
    mail)
      [ "$#" -eq 0 ] || die "mail takes nothing more"
      run_op 60 mail
      ;;
    rotate-secrets)
      [ "$#" -eq 0 ] || die "rotate-secrets takes nothing more"
      run_op 120 rotate-secrets
      ;;
    new-issue)
      local replica=1
      if [ "${1:-}" = --replica ]; then
        replica=$(replica_number "${2:-}")
        shift 2
      fi
      [ "$#" -eq 3 ] || die "usage: examine-foundry new-issue [--replica 2] <viewer> <team>/<project> <title>"
      local viewer
      viewer=$(viewer_key "$1") || die "no viewer named $1 (see: examine-foundry viewers)"
      [ "$viewer" != signed-out ] || die "new-issue needs a signed-in viewer"
      case "$2" in
        */*/* | /* | */ | *[!a-z0-9/-]*) die "the project is <team>/<project>, such as backend/identity-platform, not $2" ;;
        */*) ;;
        *) die "the project is <team>/<project>, such as backend/identity-platform, not $2" ;;
      esac
      [ -n "$3" ] || die "new-issue needs a title"
      run_op 120 post "$replica" "$viewer" "team/${2%%/*}/project/${2#*/}/issues" "title=$3"
      ;;
    slack-posting)
      [ "$#" -eq 1 ] || die "usage: examine-foundry slack-posting <answering|not-answering|slow-down>"
      case "$1" in
        answering | not-answering | slow-down) ;;
        *) die "slack-posting takes answering, not-answering or slow-down, not $1" ;;
      esac
      run_op 60 slack-posting "$1"
      ;;
    time-passes)
      [ "$#" -eq 1 ] || die "usage: examine-foundry time-passes <N>m | <N>h (such as 11m or 24h)"
      case "$1" in
        *[!0-9mh]* | [mh]* | *[mh]*[mh]* | *[0-9]) die "time-passes takes minutes or hours, such as 11m or 24h, not $1" ;;
      esac
      run_op 60 time-passes "$1"
      ;;
    slack-event)
      local replica=1
      if [ "${1:-}" = --replica ]; then
        replica=$(replica_number "${2:-}")
        shift 2
      fi
      [ "$#" -ge 1 ] || die "usage: examine-foundry slack-event <planted|rotated|none|SECRET> [url-verification | app-uninstalled <Slack workspace>]"
      case "${2:-url-verification}" in
        url-verification) [ "$#" -le 2 ] || die "url-verification takes nothing more" ;;
        app-uninstalled) [ "$#" -eq 3 ] || die "app-uninstalled names one Slack workspace, such as \"Canzan Labs\"" ;;
        *) die "no Slack event named $2; use url-verification or app-uninstalled" ;;
      esac
      run_op 60 slack-event "$replica" "$@"
      ;;
    "" | -h | --help | help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

replica_number() {
  case "$1" in
    1 | 2) printf '%s\n' "$1" ;;
    *) die "--replica takes 1 or 2" ;;
  esac
}

run_op() {
  local limit="$1"
  shift
  if [ "$(uname -s)" = Linux ]; then
    timeout "$limit" bash "$SELF" __vm "$@"
  else
    vm_up
    in_vm "$limit" nolock __vm "$@"
  fi
}

# gate | suite: the examiner's files go to the VM as one tar, and the VM stages
# the candidate with them. Paths are read from the caller's directory.
host_contributor() {
  local op="$1" tag='' limit=900
  shift
  if [ "$op" = suite ]; then
    # A tag is written as in a feature file, with or without its @.
    tag="${1#@}"
    case "$tag" in
      [a-z0-9]*) ;;
      *) die "usage: examine-foundry suite <tag> [--file <repo path> <your file>]... (such as us-cts-04)" ;;
    esac
    case "$tag" in *[!a-z0-9_-]*) die "a tag is lowercase letters, digits, _ or -, not $1" ;; esac
    limit=3600
    shift
  fi
  local files="$TMPDIR_HOST/examine-foundry-files"
  rm -rf "$files"
  mkdir -p "$files/tree"
  while [ "$#" -gt 0 ]; do
    [ "$1" = --file ] && [ "$#" -ge 3 ] || die "each file is --file <repo path> <your file>, not $1"
    local target="$2" source="$3"
    case "$target" in
      crates/foundry-app/templates/base.html | crates/foundry-app/static/?*) ;;
      *) die "a --file replaces crates/foundry-app/templates/base.html or a file under crates/foundry-app/static/, not $target" ;;
    esac
    case "/$target/" in
      */../* | */./* | *//*) die "no empty, . or .. part in $target" ;;
    esac
    case "$target" in *[!A-Za-z0-9._/-]*) die "a repo path is letters, digits, . _ - and /, not $target" ;; esac
    [ -f "$source" ] || die "no file $source"
    mkdir -p "$files/tree/$(dirname "$target")"
    cp "$source" "$files/tree/$target"
    shift 3
  done
  local tar="$TMPDIR_HOST/examine-foundry-files.tar"
  if [ "$(uname -s)" = Darwin ]; then
    # No AppleDouble ._ files or extended attributes in the staged tree.
    COPYFILE_DISABLE=1 tar --no-mac-metadata --no-xattrs -cf "$tar" -C "$files/tree" .
  else
    tar -cf "$tar" -C "$files/tree" .
  fi
  rm -rf "$files"
  if [ "$(uname -s)" = Linux ]; then
    (
      flock -w 900 9 || die "another test run holds ~/test.lock"
      timeout "$limit" bash "$SELF" __vm contributor "$op" "$tag" "$tar" "$ROOT" 9>&-
    ) 9>"$HOME/test.lock"
    return
  fi
  vm_up
  local remote=/tmp/examine-foundry-files.tar
  timeout 60 limactl copy "$tar" "$VM:$remote" 2>/dev/null || die "could not copy the files into $VM"
  rm -f "$tar"
  # test-in-lima.sh syncs the checkout first, so the VM stages this candidate.
  (cd "$ROOT" && timeout "$limit" scripts/test-in-lima.sh \
    bash scripts/examine-foundry __vm contributor "$op" "$tag" "$remote" foundry)
}

# On a Linux host: build here, then boot, all under ~/test.lock.
local_start() {
  # A restricted PATH may not reach rustup's cargo.
  if ! command -v cargo >/dev/null && [ -f "$HOME/.cargo/env" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.cargo/env"
  fi
  (
    flock -w 900 9 || die "another test run holds ~/test.lock"
    local tree="$ROOT"
    if [ -n "$2" ]; then
      timeout 3600 bash "$SELF" __vm build-before "$2" "$ROOT" >&2 9>&- ||
        die "building the release foundry binary at $2 failed"
      tree="$HOME/$BEFORE_TREE"
    else
      (cd "$ROOT" && timeout 3600 cargo build --release -p foundry-app --bin foundry) >&2 ||
        die "building the release foundry binary failed"
    fi
    timeout 900 bash "$SELF" __vm start "$1" "$tree" "$3" 9>&-
  ) 9>"$HOME/test.lock"
}

# ----------------------------------------------------------------- the VM side
# Everything below runs where Foundry runs (the VM, or a Linux host).

vm_dirs() {
  STATE_DIR="$HOME/examine-foundry"
  JARS="$STATE_DIR/jars"
  BASE="http://127.0.0.1:$PORT"
  BASE_1="$BASE"
  BASE_2="http://127.0.0.1:$PORT_2"
  DATABASE_URL="postgres://postgres:examine@127.0.0.1:$PG_PORT/foundry"
}

# Check out COMMIT in the baseline clone (made from SOURCE, the synced tree or
# this checkout) and build its release binary there. Runs under ~/test.lock.
vm_build_before() {
  local commit="$1" source="$2" clone="$HOME/$BEFORE_TREE"
  case "$source" in /*) ;; *) source="$HOME/$source" ;; esac
  git -C "$source" cat-file -e "$commit^{commit}" 2>/dev/null ||
    die "commit $commit is not in the history of $source"
  if [ ! -d "$clone/.git" ]; then
    mkdir -p "$(dirname "$clone")"
    git clone -q --no-checkout "$source" "$clone" || die "could not clone $source for the baseline"
  fi
  git -C "$clone" fetch -q "$source" '+refs/heads/*:refs/remotes/origin/*' ||
    die "could not fetch $source into the baseline clone"
  git -C "$clone" checkout -q -f --detach "$commit" || die "could not check out $commit"
  git -C "$clone" clean -q -f -d -x -e /target
  (cd "$clone" && CARGO_BUILD_JOBS=4 cargo build --release -p foundry-app --bin foundry) ||
    die "building the release foundry binary at $commit failed"
}

# ---- the Slack double -----------------------------------------------------------

start_slack_double() {
  slack_double_py >"$STATE_DIR/slack-double.py"
  setsid python3 -I "$STATE_DIR/slack-double.py" "$SLACK_PORT" "$STATE_DIR/slack-next-team" \
    "$STATE_DIR/slack-double.log" "$STATE_DIR/slack-posting" "$STATE_DIR/mail.log" \
    >"$STATE_DIR/slack-double.err" 2>&1 </dev/null 9>&- &
  printf '%s\n' "$!" >"$STATE_DIR/slack-double.pid"
  local _
  for _ in $(seq 1 40); do
    if curl -s -o /dev/null --max-time 2 "$SLACK_BASE/api/api.test"; then
      return 0
    fi
    sleep 0.25
  done
  die "the Slack double did not start: $(tail -n 3 "$STATE_DIR/slack-double.err")"
}

slack_info() {
  cat <<INFO
Slack double: $SLACK_BASE (Foundry's SLACK_API_BASE_URL is $SLACK_BASE/api, SLACK_AUTHORIZE_URL is $SLACK_BASE/oauth/v2/authorize)
Slack workspaces its approval screen knows: Canzan Labs (T0CANZANLABS), Ops Guild (T0OPSGUILD), Reading Club (T0READINGCLUB); it approves $(cat "$STATE_DIR/slack-next-team" 2>/dev/null || echo "Canzan Labs") next
Channels in every Slack workspace: #auth-dev (C0AUTHDEV), #auth-releases (C0AUTHREL), #general (C0GENERAL), #ops-alerts (C0OPSALRT)
Planted Slack app: client ID $SLACK_ID, client secret $SLACK_SECRET, signing secret $SLACK_SIGNING
Another app's client ID: 6123456789012.8888888888888; another signing secret (rotated): $SLACK_SIGNING_ROTATED
The double accepts any client secret and signs nothing; slack-event signs the events it sends.
slack-event signs with the secret it names: planted = $SLACK_SIGNING, rotated = $SLACK_SIGNING_ROTATED. To rotate the saved app's signing secret so slack-event can test it: post Priya admin/instance/integrations/slack client_id=$SLACK_ID client_secret= signing_secret=$SLACK_SIGNING_ROTATED
Posting (chat.postMessage) now: $(cat "$STATE_DIR/slack-posting" 2>/dev/null || echo answering) (change it with slack-posting answering|not-answering|slow-down)
Foundry replicas: $(replicas_line)
Calls Foundry made to the double, oldest first:
INFO
  if [ -s "$STATE_DIR/slack-double.log" ]; then
    python3 -I -c '
import json, sys
for line in open(sys.argv[1], encoding="utf-8"):
    c = json.loads(line)
    extra = " ".join(f"{k}={v}" for k, v in c.items() if k not in ("method",))
    print("  " + c["method"] + (" " + extra if extra else ""))
' "$STATE_DIR/slack-double.log"
  else
    echo "  none"
  fi
}

replicas_line() {
  if [ -f "$STATE_DIR/foundry-2.pid" ]; then
    echo "replica 1 at $PUBLIC_URL (port $PORT) and replica 2 (port $PORT_2), on one database"
  else
    echo "replica 1 only (start with --replicas 2 for a second)"
  fi
}

# slack-posting MODE: how the double answers chat.postMessage from now on:
# answering (ok), not-answering (HTTP 503, no body: Slack not answering) or
# slow-down (HTTP 429, Retry-After 600: Slack asks Foundry to slow down).
slack_posting() {
  printf '%s\n' "$1" >"$STATE_DIR/slack-posting"
  echo "examine-foundry: the Slack double is now $1 to chat.postMessage"
}

# The mail Foundry sent through its email_api provider, oldest first.
mail_print() {
  cat <<INFO
Mail double: Foundry sends mail with NOTIFICATION_PROVIDERS=email_api to $SLACK_BASE/mail/send; it accepts every message.
Mail Foundry sent, oldest first:
INFO
  if [ -s "$STATE_DIR/mail.log" ]; then
    python3 -I -c '
import json, sys
for n, line in enumerate(open(sys.argv[1], encoding="utf-8"), 1):
    m = json.loads(line)
    print("mail %d at %s" % (n, m.get("received_at", "?")))
    print("  from: " + str(m.get("from", "")))
    print("  to: " + str(m.get("to", "")))
    print("  subject: " + str(m.get("subject", "")))
    if m.get("event"):
        print("  event: " + str(m["event"]))
    for body_line in str(m.get("body", "")).splitlines() or [""]:
        print("  | " + body_line)
' "$STATE_DIR/mail.log"
  else
    echo "  none"
  fi
}

# time-passes <N>m|<N>h: as if that time had passed for what is waiting. The
# held Slack app's expiry and every waiting delivery's time stamps move into
# the past; nothing else changes, Foundry's clock included.
time_passes() {
  local amount="$1" interval
  case "$amount" in
    *m) interval="${amount%m} minutes" ;;
    *h) interval="${amount%h} hours" ;;
  esac
  local counts
  counts=$(docker exec "$PG_NAME" psql -q -At -v ON_ERROR_STOP=1 -U postgres -d foundry -c "
    WITH held AS (
      UPDATE instance_slack_app_pending SET expires_at = expires_at - interval '$interval'
      RETURNING 1
    ), waiting AS (
      UPDATE integration_deliveries SET
        occurred_at = occurred_at - interval '$interval',
        give_up_at = give_up_at - interval '$interval',
        first_attempt_at = first_attempt_at - interval '$interval',
        next_attempt_at = next_attempt_at - interval '$interval',
        lease_until = lease_until - interval '$interval'
      WHERE status = 'pending'
      RETURNING 1
    )
    SELECT (SELECT count(*) FROM held) || ' ' || (SELECT count(*) FROM waiting);") ||
    die "could not move the waiting time stamps"
  local held="${counts%% *}" waiting="${counts##* }"
  printf 'examine-foundry: %s passed; moved back: Slack apps waiting for a confirm %s, waiting deliveries %s\n' \
    "$interval" "$held" "$waiting"
}

# slack_event SECRET [KIND [TEAM]]: an Events API post as Slack sends it, signed
# with SECRET (planted, rotated, none, or the secret itself).
slack_event() {
  local which="$1" kind="${2:-url-verification}" team="${3:-}" secret
  case "$which" in
    planted) secret="$SLACK_SIGNING" ;;
    rotated) secret="$SLACK_SIGNING_ROTATED" ;;
    none) secret= ;;
    *) secret="$which" ;;
  esac
  python3 -I -c '
import hashlib, hmac, json, sys, time, urllib.error, urllib.request
base, secret, kind, team = sys.argv[1:5]
teams = {"Canzan Labs": "T0CANZANLABS", "Ops Guild": "T0OPSGUILD", "Reading Club": "T0READINGCLUB"}
if kind == "url-verification":
    envelope = {"token": "deprecated-verification-token", "challenge": "probe-challenge-1", "type": "url_verification"}
else:
    if team not in teams:
        sys.exit("examine-foundry: the Slack double knows Canzan Labs, Ops Guild and Reading Club, not " + team)
    envelope = {"token": "deprecated-verification-token", "team_id": teams[team], "api_app_id": "A0PROBEFOUNDRY",
                "type": "event_callback", "event_id": "EvProbe%d" % time.time_ns(), "event_time": int(time.time()),
                "event": {"type": "app_uninstalled"}}
body = json.dumps(envelope).encode()
request = urllib.request.Request(base + "/integrations/slack/events", data=body, method="POST",
                                 headers={"Content-Type": "application/json"})
if secret:
    ts = str(int(time.time()))
    mac = hmac.new(secret.encode(), b"v0:" + ts.encode() + b":" + body, hashlib.sha256).hexdigest()
    request.add_header("X-Slack-Request-Timestamp", ts)
    request.add_header("X-Slack-Signature", "v0=" + mac)
try:
    answer = urllib.request.urlopen(request, timeout=30)
except urllib.error.HTTPError as error:
    answer = error
print("sent: " + kind + (" for " + team if team else "") + (" signed" if secret else " unsigned"))
print("status: %d %s" % (answer.status, answer.reason))
print("content-type: " + (answer.headers.get("Content-Type") or "none"))
print()
print(answer.read().decode("utf-8", "replace").strip()[:2000])
' "$BASE" "$secret" "$kind" "$team"
}

slack_double_py() {
  cat <<'PY'
import json, sys, time, uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit, urlencode

port, next_team_file, log_file = int(sys.argv[1]), sys.argv[2], sys.argv[3]
posting_file, mail_file = sys.argv[4], sys.argv[5]
TEAMS = {
    "Canzan Labs": ("T0CANZANLABS", "canzanlabs"),
    "Ops Guild": ("T0OPSGUILD", "opsguild"),
    "Reading Club": ("T0READINGCLUB", "readingclub"),
}
BY_ID = {team_id: (name, domain) for name, (team_id, domain) in TEAMS.items()}
CHANNELS = [("C0AUTHDEV", "auth-dev"), ("C0AUTHREL", "auth-releases"),
            ("C0GENERAL", "general"), ("C0OPSALRT", "ops-alerts")]
APP_ID = "A0PROBEFOUNDRY"

def log(method, **fields):
    with open(log_file, "a", encoding="utf-8") as f:
        f.write(json.dumps({"method": method, **fields}) + "\n")

def posting():
    try:
        mode = open(posting_file, encoding="utf-8").read().strip()
    except OSError:
        mode = ""
    return mode if mode in ("not-answering", "slow-down") else "answering"

def next_team():
    try:
        name = open(next_team_file, encoding="utf-8").read().strip()
    except OSError:
        name = ""
    return name if name in TEAMS else "Canzan Labs"

def channel(cid, name):
    return {"id": cid, "name": name, "is_channel": True, "is_group": False, "is_private": False,
            "is_archived": False, "is_ext_shared": False, "is_shared": False, "is_member": True}

class Slack(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def answer(self, status, body, headers=()):
        data = json.dumps(body).encode() if body is not None else b""
        self.send_response(status)
        if body is not None:
            self.send_header("Content-Type", "application/json; charset=utf-8")
        for k, v in headers:
            self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def args(self):
        url = urlsplit(self.path)
        pairs = {k: v[0] for k, v in parse_qs(url.query).items()}
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length).decode("utf-8", "replace") if length else ""
        if raw.strip().startswith("{"):
            try:
                pairs.update(json.loads(raw))
            except ValueError:
                pass
        else:
            pairs.update({k: v[0] for k, v in parse_qs(raw).items()})
        return url.path, pairs

    def team(self):
        token = (self.headers.get("Authorization") or "").removeprefix("Bearer ")
        return BY_ID.get(token.removeprefix("xoxb-probe-")) and token.removeprefix("xoxb-probe-")

    def do_GET(self):
        self.handle_call()

    def do_POST(self):
        self.handle_call()

    def handle_call(self):
        path, a = self.args()
        if path == "/mail/send":
            # The email_api provider's send: {from, to, subject, body, event}.
            with open(mail_file, "a", encoding="utf-8") as f:
                f.write(json.dumps({**{k: a.get(k, "") for k in ("from", "to", "subject", "body", "event")},
                                    "received_at": time.strftime("%H:%M:%S UTC", time.gmtime())}) + "\n")
            return self.answer(200, {"ok": True, "id": uuid.uuid4().hex})
        if path == "/oauth/v2/authorize":
            name = next_team()
            team_id = TEAMS[name][0]
            log("oauth.v2.authorize", approved=name)
            code = "probe-code-%s-%s" % (team_id, uuid.uuid4().hex[:8])
            back = a.get("redirect_uri", "")
            sep = "&" if "?" in back else "?"
            return self.answer(302, None, [("Location", back + sep + urlencode({"code": code, "state": a.get("state", "")}))])
        if not path.startswith("/api/"):
            return self.answer(404, {"ok": False, "error": "unknown_method"})
        method = path[len("/api/"):]
        if method == "api.test":
            return self.answer(200, {"ok": True})
        if method == "oauth.v2.access":
            parts = a.get("code", "").split("-")
            team_id = parts[2] if len(parts) > 3 else ""
            if team_id not in BY_ID or not a.get("client_secret"):
                log(method, refused="invalid_code")
                return self.answer(200, {"ok": False, "error": "invalid_code"})
            log(method, team=BY_ID[team_id][0], client_id=a.get("client_id", ""))
            return self.answer(200, {"ok": True, "access_token": "xoxb-probe-" + team_id, "token_type": "bot",
                                     "scope": "chat:write,chat:write.public,channels:read,groups:read",
                                     "bot_user_id": "U0FOUNDRYBOT", "app_id": APP_ID,
                                     "team": {"id": team_id, "name": BY_ID[team_id][0]},
                                     "enterprise": None, "is_enterprise_install": False})
        team_id = self.team()
        if not team_id:
            log(method, refused="invalid_auth")
            return self.answer(200, {"ok": False, "error": "invalid_auth"})
        name, domain = BY_ID[team_id]
        if method == "auth.test":
            log(method, team=name)
            return self.answer(200, {"ok": True, "url": "https://%s.slack.com/" % domain, "team": name,
                                     "user": "foundry", "team_id": team_id, "user_id": "U0FOUNDRYBOT",
                                     "bot_id": "B0FOUNDRYBOT", "is_enterprise_install": False})
        if method == "conversations.list":
            log(method, team=name)
            return self.answer(200, {"ok": True, "channels": [channel(*c) for c in CHANNELS],
                                     "response_metadata": {"next_cursor": ""}})
        if method == "conversations.info":
            found = [c for c in CHANNELS if c[0] == a.get("channel")]
            log(method, team=name, channel=a.get("channel", ""))
            if not found:
                return self.answer(200, {"ok": False, "error": "channel_not_found"})
            return self.answer(200, {"ok": True, "channel": channel(*found[0])})
        if method == "chat.postMessage":
            text = a.get("text") or ""
            mode = posting()
            fields = {"team": name, "channel": a.get("channel", ""), "text": " ".join(str(text).split())[:200]}
            if mode == "not-answering":
                log(method, answered="HTTP 503 (not answering)", **fields)
                return self.answer(503, None)
            if mode == "slow-down":
                log(method, answered="HTTP 429 ratelimited, Retry-After 600 (slow down)", **fields)
                return self.answer(429, {"ok": False, "error": "ratelimited"}, [("Retry-After", "600")])
            log(method, **fields)
            return self.answer(200, {"ok": True, "channel": a.get("channel", ""), "ts": "%.6f" % time.time()})
        if method == "chat.delete":
            log(method, team=name, channel=a.get("channel", ""))
            return self.answer(200, {"ok": True, "channel": a.get("channel", ""), "ts": a.get("ts", "")})
        if method == "apps.uninstall":
            log(method, team=name)
            return self.answer(200, {"ok": True})
        log(method, refused="unknown_method")
        return self.answer(200, {"ok": False, "error": "unknown_method"})

ThreadingHTTPServer(("127.0.0.1", port), Slack).serve_forever()
PY
}

vm_teardown() {
  if [ -f "$STATE_DIR/foundry.pid" ]; then
    local pid
    pid=$(cat "$STATE_DIR/foundry.pid")
    kill "$pid" 2>/dev/null || true

    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    kill -9 "$pid" 2>/dev/null || true
  fi
  if [ -f "$STATE_DIR/foundry-2.pid" ]; then
    kill -9 "$(cat "$STATE_DIR/foundry-2.pid")" 2>/dev/null || true
  fi
  pkill -9 -f "$STATE_DIR/bin/foundry" 2>/dev/null || true
  if [ -f "$STATE_DIR/slack-double.pid" ]; then
    kill -9 "$(cat "$STATE_DIR/slack-double.pid")" 2>/dev/null || true
  fi
  pkill -9 -f "$STATE_DIR/slack-double.py" 2>/dev/null || true
  pkill -9 -f "user-data-dir=$STATE_DIR/browser/" 2>/dev/null || true
  docker rm -f "$PG_NAME" >/dev/null 2>&1 || true
  if [ -f "$STATE_DIR/data-dir" ]; then
    rm -rf "$(cat "$STATE_DIR/data-dir")"
  fi
  rm -rf "$STATE_DIR"
}

vm_require_running() {
  if ! { [ -f "$STATE_DIR/foundry.pid" ] && kill -0 "$(cat "$STATE_DIR/foundry.pid")" 2>/dev/null; }; then
    die "no probe instance is running; run: examine-foundry start <state>"
  fi
}

# use_replica N: point the requests at replica N.
use_replica() {
  case "$1" in
    1) BASE="$BASE_1" ;;
    2)
      if ! { [ -f "$STATE_DIR/foundry-2.pid" ] && kill -0 "$(cat "$STATE_DIR/foundry-2.pid")" 2>/dev/null; }; then
        die "no replica 2 is running; start the state with --replicas 2"
      fi
      BASE="$BASE_2"
      ;;
  esac
}

port_free() {
  ! ss -Hltn "sport = :$1" 2>/dev/null | grep -q .
}

vm_start() {
  local state="$1" root="$2" replicas="${3:-1}"
  case "$root" in /*) ;; *) root="$HOME/$root" ;; esac
  local binary="$root/target/release/foundry"
  [ -x "$binary" ] || die "no release binary at $binary"
  vm_teardown
  local p
  for p in "$PORT" "$METRICS_PORT" "$PG_PORT" "$SLACK_PORT" "$PORT_2" "$METRICS_PORT_2"; do
    port_free "$p" || die "port $p is in use in this machine; stop whatever listens there"
  done
  mkdir -p "$STATE_DIR/bin" "$JARS"
  cp "$binary" "$STATE_DIR/bin/foundry"

  docker run -d --name "$PG_NAME" --label foundry-examine=1 \
    -e POSTGRES_PASSWORD=examine -e POSTGRES_DB=foundry \
    -p "127.0.0.1:$PG_PORT:5432" "$PG_IMAGE" >/dev/null ||
    die "could not start the $PG_IMAGE container"
  local ready=
  for _ in $(seq 1 60); do
    if docker exec "$PG_NAME" pg_isready -U postgres -d foundry -h 127.0.0.1 >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 1
  done
  [ -n "$ready" ] || die "Postgres did not become ready within 60 seconds"

  # A fixed temp path, so the pages that name it read the same on every start.
  local data_dir=/tmp/examine-foundry-data
  rm -rf "$data_dir"
  mkdir -m 700 "$data_dir"
  printf '%s\n' "$data_dir" >"$STATE_DIR/data-dir"
  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$STATE_DIR/session-secret"
  # The machine-token keypair a deploy supplies; this one lives as long as the probe.
  openssl genpkey -algorithm ed25519 -out "$STATE_DIR/machine-token.pem" 2>/dev/null ||
    die "openssl could not make the machine-token key"
  openssl pkey -in "$STATE_DIR/machine-token.pem" -pubout -out "$STATE_DIR/machine-token.pub" ||
    die "openssl could not derive the machine-token public key"

  # Two operator instance keys (32 random bytes, base64url): the one a state
  # starts with, and the different one it may restart with.
  local k
  for k in instance-key instance-key-other; do
    python3 -I -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip("="))' \
      >"$STATE_DIR/$k" || die "could not make an instance key"
  done

  start_slack_double

  # Each replica's own settings, beside the ones every replica has.
  local hook="env_${state//-/_}"
  : >"$STATE_DIR/env-1"
  if declare -F "$hook" >/dev/null; then
    "$hook" >"$STATE_DIR/env-1"
  fi
  cp "$STATE_DIR/env-1" "$STATE_DIR/env-2"

  launch_foundry 1
  seed_people_team_project
  "seed_${state//-/_}"
  # Replica 2 boots once the state is seeded, so the bootstrap link is replica 1's;
  # a state may have started it already.
  if [ "$replicas" = 2 ] && [ ! -f "$STATE_DIR/foundry-2.pid" ]; then
    launch_foundry 2
  fi
  printf '%s %s\n' "$state" "$root" >"$STATE_DIR/state"
  printf 'examine-foundry: started in state %s (%s)\n' "$state" \
    "$(states_table | awk -F'\t' -v s="$state" '$1 == s { print $2 }')"
  printf 'examine-foundry: %s\n' "$(replicas_line)"
}

# server_env N: replica N's settings, in SERVER_ENV, as env takes them. Every
# replica has the same settings but its ports and what $STATE_DIR/env-N adds
# (a later KEY=VALUE wins).
server_env() {
  local n="$1" port="$PORT" metrics="$METRICS_PORT" extra=()
  if [ "$n" = 2 ]; then
    port="$PORT_2"
    metrics="$METRICS_PORT_2"
  fi
  if [ -s "$STATE_DIR/env-$n" ]; then
    mapfile -t extra < <(grep -v '^$' "$STATE_DIR/env-$n" || true)
  fi
  # NixOS keeps its tools in /run/current-system/sw/bin, not /usr/bin.
  SERVER_ENV=(PATH=/usr/local/bin:/usr/bin:/bin:/run/current-system/sw/bin HOME="$HOME"
    DATABASE_URL="$DATABASE_URL"
    SESSION_SECRET="$(cat "$STATE_DIR/session-secret")"
    SESSION_COOKIE_SECURE=false
    MACHINE_TOKEN_PUBLIC_KEYS="$(cat "$STATE_DIR/machine-token.pub")"
    MACHINE_TOKEN_SIGNING_KEY="$(cat "$STATE_DIR/machine-token.pem")"
    FOUNDRY_HOST=127.0.0.1 FOUNDRY_PORT="$port"
    METRICS_HOST=127.0.0.1 METRICS_PORT="$metrics"
    FOUNDRY_DATA_DIR="$(cat "$STATE_DIR/data-dir")"
    FOUNDRY_PUBLIC_URL="$PUBLIC_URL"
    FOUNDRY_INTEGRATIONS_RELOAD_MS=200
    RUST_LOG=info
    SLACK_API_BASE_URL="$SLACK_BASE/api"
    SLACK_AUTHORIZE_URL="$SLACK_BASE/oauth/v2/authorize"
    NOTIFICATION_PROVIDERS=email_api
    EMAIL_API_URL="$SLACK_BASE/mail/send"
    EMAIL_API_KEY=examine-foundry-mail-key
    EMAIL_API_FROM=foundry@foundry.example.org
    "${extra[@]+"${extra[@]}"}")
}

# launch_foundry N: replica N of this Foundry, and wait until it is ready.
launch_foundry() {
  local n="$1" port="$PORT" suffix=
  if [ "$n" = 2 ]; then
    port="$PORT_2"
    suffix="-$n"
  fi
  server_env "$n"
  # setsid + closed descriptors: the server outlives this shell and holds no lock.
  env -i "${SERVER_ENV[@]}" \
    setsid "$STATE_DIR/bin/foundry" >"$STATE_DIR/foundry$suffix.log" 2>&1 </dev/null 9>&- &
  printf '%s\n' "$!" >"$STATE_DIR/foundry$suffix.pid"

  local ready=
  for _ in $(seq 1 120); do
    kill -0 "$(cat "$STATE_DIR/foundry$suffix.pid")" 2>/dev/null || break
    if [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$port/readyz")" = 200 ]; then
      ready=1
      break
    fi
    sleep 0.5
  done
  if [ -z "$ready" ]; then
    tail -n 20 "$STATE_DIR/foundry$suffix.log" >&2
    vm_teardown
    die "Foundry replica $n did not become ready within 60 seconds"
  fi
}

# stop_replica N: replica N stops as a pod does (TERM, then KILL after 10 s).
stop_replica() {
  local suffix=
  [ "$1" = 1 ] || suffix="-$1"
  local pidfile="$STATE_DIR/foundry$suffix.pid" pid
  [ -f "$pidfile" ] || return 0
  pid=$(cat "$pidfile")
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2
  done
  kill -9 "$pid" 2>/dev/null || true
  rm -f "$pidfile"
}

# restart_replica N KEY=VALUE...: replica N restarts with these settings in
# place of the ones its state gave it.
restart_replica() {
  local n="$1"
  shift
  : >"$STATE_DIR/env-$n"
  [ "$#" -eq 0 ] || printf '%s\n' "$@" >"$STATE_DIR/env-$n"
  stop_replica "$n"
  launch_foundry "$n"
}

# `foundry doctor rotate-secrets`, the operator's own key rotation, run as an
# operator runs it: the same binary with replica 1's settings as they are now.
rotate_secrets() {
  server_env 1
  local out status=0
  out=$(env -i "${SERVER_ENV[@]}" timeout 60 "$STATE_DIR/bin/foundry" doctor rotate-secrets 2>&1) ||
    status=$?
  printf 'ran: foundry doctor rotate-secrets (with the settings replica 1 runs with)\n'
  printf 'exit status: %s\n\n%s\n' "$status" "$out"
}

# Stage the candidate CANDIDATE (relative to the VM home, or absolute) with the
# files in TAR, then run the gate or the scenarios with TAG over it.
vm_contributor() {
  local op="$1" tag="$2" tar="$3" candidate="$4"
  case "$candidate" in /*) ;; *) candidate="$HOME/$candidate" ;; esac
  local stage="$HOME/examine-foundry-gate/repo"
  mkdir -p "$stage"
  rsync -a --delete --exclude=/target --exclude=/.git "$candidate/" "$stage/"
  tar -xf "$tar" -C "$stage"
  rm -f "$tar"
  echo "== what the staged tree changes in the candidate"
  (cd "$HOME" && diff -ruN --exclude=target --exclude=.git "$candidate/crates/foundry-app" "$stage/crates/foundry-app" |
    sed "s|$candidate/|candidate/|; s|$stage/|staged/|") || true
  echo "== end of changes"
  local status=0
  if [ "$op" = gate ]; then
    echo "== cargo xtask check-arch over the staged tree"
    (cd "$candidate" && CARGO_BUILD_JOBS=4 cargo run -q -p xtask -- check-arch --root "$stage") 2>&1 || status=$?
    echo "== check-arch exit $status"
    return 0
  fi
  local log="$HOME/examine-foundry-gate/build.log"
  echo "== building the acceptance suite from the staged tree"
  # Its own target directory, kept across stop as a build cache: cargo names the
  # staged crates as it names the candidate's, so a shared one would overwrite
  # the candidate's build. A scenario that runs the foundry binary runs the
  # candidate's release binary.
  local target="$HOME/examine-foundry-gate/target"
  if ! (cd "$stage" && CARGO_TARGET_DIR="$target" CARGO_BUILD_JOBS=4 \
    cargo test -p foundry-acceptance --release --test acceptance --no-run) >"$log" 2>&1; then
    tail -n 40 "$log"
    echo "== the staged tree does not build; no scenario ran"
    return 0
  fi
  echo "== FOUNDRY_ACCEPTANCE_TAGS=$tag cargo test -p foundry-acceptance --release --test acceptance"
  (cd "$stage" && CARGO_TARGET_DIR="$target" CARGO_BUILD_JOBS=4 FOUNDRY_ACCEPTANCE_TAGS="$tag" \
    CARGO_BIN_EXE_foundry="$candidate/target/release/foundry" \
    cargo test -p foundry-acceptance --release --test acceptance) >"$log" 2>&1 || status=$?
  # Failures and the summary come last; the passing steps before them are dropped.
  # and so are the harness's curl retries while a server starts.
  grep -v -E '^\s+✔|^curl: \([0-9]+\)' "$log" | tail -n 150
  echo "== suite exit $status"
}

vm_stop() {
  vm_teardown
  rm -rf "$HOME/examine-foundry-gate/repo"
  docker ps -aq --filter label=foundry-examine=1 | xargs -r docker rm -f >/dev/null
  echo "examine-foundry: stopped; no probe container or process is left"
}

# ---- HTTP as a browser would -------------------------------------------------

# A path of this Foundry for whatever the server or the caller gave.
local_url() {
  local target="$1" current="$2"
  case "$target" in
    "$PUBLIC_URL"/* | "$PUBLIC_URL") printf '%s%s\n' "$BASE" "${target#"$PUBLIC_URL"}" ;;
    "$BASE"/* | "$BASE") printf '%s\n' "$target" ;;
    # The Slack double's approval screen, as a browser would visit Slack's.
    "$SLACK_BASE"/*) printf '%s\n' "$target" ;;
    //* | http://* | https://*) return 1 ;;
    /*) printf '%s%s\n' "$BASE" "$target" ;;
    \?*) printf '%s%s\n' "${current%%\?*}" "$target" ;;
    *) printf '%s/%s\n' "${current%/*}" "$target" ;;
  esac
}

csrf_of() {
  [ -f "$1" ] || return 0
  awk '$6 == "foundry_csrf" { v = $7 } END { if (v != "") print v }' "$1"
}

has_session() {
  [ -f "$1" ] && awk '$6 == "foundry_session" { f = 1 } END { exit !f }' "$1"
}

# http VIEWER METHOD PATH [key=value ...]: the request with the viewer's cookies,
# the CSRF token a form carries, and redirects followed within this Foundry.
# Leaves the last answer in $STATE_DIR/last.{headers,body} and sets
# HTTP_STATUS, HTTP_CODE, HTTP_TYPE, HTTP_FINAL, HTTP_REDIRECTED, HTTP_LEFT.
http() {
  local viewer="$1" method="$2" path="$3"
  shift 3
  local jar="$JARS/$viewer.txt" url hops=0
  [ "$viewer" = signed-out ] && jar="$JARS/signed-out.txt"
  case "$path" in /*) ;; *) path="/$path" ;; esac
  url="$BASE$path"
  local fields=("$@")
  if [ "$method" = POST ] && [ -z "$(csrf_of "$jar")" ]; then
    # A browser holds the token from the page the form was on.
    curl -s -o /dev/null --max-time 30 -b "$jar" -c "$jar" "$BASE/" || true
  fi
  HTTP_REDIRECTED=
  HTTP_LEFT=
  while :; do
    local args=(-s -S --max-time 30 -o "$STATE_DIR/last.body" -D "$STATE_DIR/last.headers"
      -b "$jar" -c "$jar")
    if [ "$method" = POST ]; then
      args+=(-X POST --data-urlencode "_csrf=$(csrf_of "$jar")")
      local f
      for f in "${fields[@]+"${fields[@]}"}"; do
        args+=(--data-urlencode "$f")
      done
    fi
    curl "${args[@]}" "$url" || die "the request to $path did not complete"
    HTTP_STATUS=$(tr -d '\r' <"$STATE_DIR/last.headers" | { grep -E '^HTTP/' || true; } | tail -n1)
    HTTP_CODE=$(printf '%s' "$HTTP_STATUS" | awk '{ print $2 }')
    HTTP_TYPE=$(header content-type)
    local location
    location=$(header location)
    case "$HTTP_CODE" in
      301 | 302 | 303 | 307 | 308) ;;
      *) break ;;
    esac
    [ -n "$location" ] || break
    local next
    if ! next=$(local_url "$location" "$url"); then
      HTTP_LEFT="$location"
      break
    fi
    hops=$((hops + 1))
    [ "$hops" -le 10 ] || die "more than 10 redirects from $path"
    HTTP_REDIRECTED=1
    url="$next"
    case "$HTTP_CODE" in 307 | 308) ;; *) method=GET ;; esac
  done
  HTTP_FINAL="${url#"$BASE"}"
}

# The last value of one response header, or nothing.
header() {
  tr -d '\r' <"$STATE_DIR/last.headers" | { grep -i "^$1:" || true; } | tail -n1 | cut -d' ' -f2-
}

sign_in() {
  local viewer="$1" email="$2"
  local jar="$JARS/$viewer.txt"
  curl -s -o /dev/null --max-time 30 -b "$jar" -c "$jar" "$BASE/sign-in" || true
  http "$viewer" POST /sign-in "email=$email" "password=$PASSWORD"
  has_session "$jar" || die "$viewer could not sign in"
}

email_of() {
  case "$1" in
    priya) echo priya.raman@example.org ;;
    tomas) echo tomas.rivera@example.org ;;
    lena) echo lena.park@example.org ;;
    omar) echo omar.haddad@example.org ;;
    rosa) echo rosa.lind@example.org ;;
    kai) echo kai.tanaka@example.org ;;
  esac
}

vm_request() {
  local method="$1" viewer="$2" path="$3"
  shift 3
  vm_require_running
  if [ "$viewer" != signed-out ] && ! has_session "$JARS/$viewer.txt"; then
    sign_in "$viewer" "$(email_of "$viewer")"
  fi
  http "$viewer" "$method" "$path" "$@"
  printf 'status: %s\n' "$HTTP_STATUS"
  printf 'content-type: %s\n' "${HTTP_TYPE:-none}"
  if [ -n "$HTTP_REDIRECTED" ]; then
    printf 'final-url: %s%s\n' "$PUBLIC_URL" "$HTTP_FINAL"
  fi
  if [ -n "$HTTP_LEFT" ]; then
    printf 'redirect-not-followed (leaves this Foundry): %s\n' "$HTTP_LEFT"
  fi
  python3 -I -c "$(extract_py)" "$STATE_DIR/last.body" "${HTTP_TYPE:-}"
}

extract_py() {
  cat <<'PY'
import html, re, sys
from html.parser import HTMLParser

body_path, content_type = sys.argv[1], sys.argv[2]
raw = open(body_path, "rb").read().decode("utf-8", "replace")

if "html" not in content_type.lower():
    print()
    text = raw if len(raw) <= 20000 else raw[:20000] + "\n[... cut at 20000 characters]"
    print(text.rstrip())
    sys.exit(0)

VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
        "param", "source", "track", "wbr"}
SKIP = {"script", "style", "template", "noscript", "head", "svg"}
BLOCK = {"p", "div", "section", "article", "header", "footer", "main", "aside", "nav",
         "h1", "h2", "h3", "h4", "h5", "h6", "li", "ul", "ol", "table", "thead", "tbody",
         "tr", "form", "fieldset", "legend", "pre", "blockquote", "dl", "dt", "dd",
         "details", "summary", "figure", "figcaption", "hr", "option", "dialog", "label",
         "button", "select", "textarea"}

class Node:
    def __init__(self, tag, attrs, parent):
        self.tag, self.attrs, self.parent, self.children = tag, dict(attrs), parent, []

class Tree(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.root = Node("#root", [], None)
        self.cur = self.root
    def handle_starttag(self, tag, attrs):
        node = Node(tag, attrs, self.cur)
        self.cur.children.append(node)
        if tag not in VOID:
            self.cur = node
    def handle_startendtag(self, tag, attrs):
        self.cur.children.append(Node(tag, attrs, self.cur))
    def handle_endtag(self, tag):
        n = self.cur
        while n is not None and n.tag != tag:
            n = n.parent
        if n is not None and n.parent is not None:
            self.cur = n.parent
    def handle_data(self, data):
        self.cur.children.append(data)

tree = Tree()
tree.feed(raw)
tree.close()

def classes(n):
    return (n.attrs.get("class") or "").split()

def find(n, pred):
    if isinstance(n, str):
        return None
    if pred(n):
        return n
    for c in n.children:
        hit = find(c, pred)
        if hit is not None:
            return hit
    return None

title_node = find(tree.root, lambda n: n.tag == "title")
root = (find(tree.root, lambda n: n.tag == "main")
        or find(tree.root, lambda n: "app-shell__content" in classes(n))
        or find(tree.root, lambda n: n.tag == "body")
        or tree.root)

def hidden(n):
    if n.tag in SKIP:
        return True
    if "hidden" in n.attrs or n.attrs.get("aria-hidden") == "true":
        return True
    if re.search(r"display\s*:\s*none", n.attrs.get("style") or ""):
        return True
    if n.tag == "aside" and "sidebar" in classes(n):
        return True
    if n.tag == "input" and (n.attrs.get("type") or "").lower() == "hidden":
        return True
    return False

def norm(s):
    return re.sub(r"\s+", " ", s).strip()

lines, links, forms = [], [], []
buf = []

def flush():
    t = norm("".join(buf))
    if t:
        lines.append(t)
    buf.clear()

def text_of(n):
    if isinstance(n, str):
        return n
    if hidden(n):
        return ""
    if n.tag == "br":
        return " "
    if n.tag == "input" and (n.attrs.get("type") or "").lower() in ("submit", "button"):
        return " " + (n.attrs.get("value") or "") + " "
    return "".join(text_of(c) for c in n.children)

def field_list(form):
    out, buttons = [], []
    def visit(n):
        if isinstance(n, str):
            return
        name = n.attrs.get("name")
        kind = (n.attrs.get("type") or "").lower()
        if n.tag == "input":
            if kind in ("submit", "button"):
                buttons.append(n.attrs.get("value") or "")
                if name:
                    out.append(f"{name}={n.attrs.get('value') or ''}")
            elif name and name != "_csrf":
                value = n.attrs.get("value")
                if kind in ("checkbox", "radio"):
                    mark = " (checked)" if "checked" in n.attrs else ""
                    out.append(f"{name}={value or 'on'} [{kind}{mark}]")
                elif kind == "password" or value is None or value == "":
                    out.append(f"{name} [{kind or 'text'}]")
                else:
                    out.append(f"{name}={value}" + (f" [{kind}]" if kind and kind != "hidden" else ""))
            return
        if n.tag == "select" and name:
            options = []
            def opts(m):
                if isinstance(m, str):
                    return
                if m.tag == "option":
                    v = m.attrs.get("value")
                    label = norm(text_of(m))
                    options.append((v if v is not None else label) + ("*" if "selected" in m.attrs else ""))
                for c in m.children:
                    opts(c)
            opts(n)
            out.append(f"{name} one of: " + ", ".join(options))
            return
        if n.tag == "textarea" and name:
            out.append(f"{name} [textarea]")
            return
        if n.tag == "button":
            buttons.append(norm(text_of(n)))
            if name:
                out.append(f"{name}={n.attrs.get('value') or ''}")
        for c in n.children:
            visit(c)
    visit(form)
    return out, buttons

def walk(n, in_pre=False):
    if isinstance(n, str):
        if in_pre:
            buf.append(n)
        else:
            buf.append(n)
        return
    if hidden(n):
        return
    if n.tag == "pre":
        flush()
        for line in "".join(text_of(c) for c in n.children).splitlines():
            if line.strip():
                lines.append(line.rstrip())
        return
    if n.tag == "a" and "href" in n.attrs:
        label = norm(text_of(n)) or norm(n.attrs.get("aria-label") or n.attrs.get("title") or "")
        links.append((label, n.attrs["href"]))
    if n.tag == "form":
        fields, buttons = field_list(n)
        method = (n.attrs.get("method") or "get").upper()
        action = n.attrs.get("action") or "(this page)"
        entry = f"form: {method} {action}"
        if fields:
            entry += " fields: " + "; ".join(fields)
        if buttons:
            entry += " buttons: " + "; ".join(b for b in buttons if b)
        forms.append(entry)
    if n.tag == "br":
        flush()
        return
    if n.tag == "input" and (n.attrs.get("type") or "").lower() in ("submit", "button"):
        buf.append(" " + (n.attrs.get("value") or "") + " ")
        return
    block = n.tag in BLOCK
    if block:
        flush()
    for c in n.children:
        walk(c)
    if block:
        flush()
    elif n.tag in ("td", "th"):
        buf.append(" ")

if title_node is not None:
    print("title: " + norm(text_of(title_node)))
walk(root)
flush()
print()
for line in lines:
    print(line)
print()
for label, href in links:
    print(f"link: {label} -> {href}")
for entry in forms:
    print(entry)
PY
}

# ---- a real browser ------------------------------------------------------------

# browser VIEWER [options] STEP...: one headless Chromium run, signed in as the
# viewer, with that viewer's own browser profile, so what a page stores in the
# browser is still there at the next `browser` call (the same browser), until
# `--fresh` or `stop`.
vm_browser() {
  local viewer="$1" width="$2" height="$3" js="$4" slow="$5" fresh="$6" mobile="$7"
  shift 7
  vm_require_running
  if [ "$viewer" != signed-out ] && ! has_session "$JARS/$viewer.txt"; then
    sign_in "$viewer" "$(email_of "$viewer")"
  fi
  local jar="$JARS/$viewer.txt"
  [ "$viewer" = signed-out ] && jar="$JARS/signed-out.txt"
  local profile="$STATE_DIR/browser/$viewer"
  # A browser left by an interrupted run would hold the profile's lock.
  pkill -9 -f "user-data-dir=$profile" 2>/dev/null || true
  rm -f "$profile/SingletonLock" "$profile/SingletonSocket" "$profile/SingletonCookie"
  [ "$fresh" = yes ] && rm -rf "$profile"
  mkdir -p "$profile"
  command -v chromium >/dev/null || die "chromium is not on the VM's PATH"
  command -v node >/dev/null || die "node is not on the VM's PATH"
  EXAMINE_EMAIL="$(email_of "$viewer")" EXAMINE_PASSWORD="$PASSWORD" \
    timeout 170 node --input-type=module -e "$(browser_js)" \
    "$BASE" "$jar" "$profile" "$width" "$height" "$js" "$slow" "$mobile" "$@"
}

browser_js() {
  cat <<'JS'
import { spawn } from "node:child_process";
import { readFileSync, existsSync } from "node:fs";

const [base, jar, profile, widthArg, heightArg, js, slow, mobile, ...steps] =
  process.argv.slice(1);
let width = Number(widthArg);
const height = Number(heightArg);
const say = (s) => process.stdout.write(s + "\n");
// A refusal closes the browser before it exits, so no Chromium keeps the
// profile locked.
const fail = (s) => {
  process.stderr.write("examine-foundry: " + s + "\n");
  try {
    chrome.kill("SIGKILL");
  } catch {}
  process.exit(1);
};

const chrome = spawn(
  "chromium",
  [
    "--headless=new",
    "--remote-debugging-port=0",
    `--user-data-dir=${profile}`,
    "--no-first-run",
    "--no-default-browser-check",
    "--disable-background-networking",
    "--disable-sync",
    `--window-size=${width},${height}`,
    "about:blank",
  ],
  { stdio: ["ignore", "ignore", "pipe"] },
);
const wsUrl = await new Promise((resolve, reject) => {
  let err = "";
  const timer = setTimeout(() => reject(new Error("Chromium did not start: " + err.slice(-400))), 30000);
  chrome.stderr.on("data", (d) => {
    err += d;
    const m = err.match(/DevTools listening on (ws:\/\/\S+)/);
    if (m) {
      clearTimeout(timer);
      resolve(m[1]);
    }
  });
  chrome.on("exit", (c) => reject(new Error(`Chromium exited (${c}): ` + err.slice(-400))));
}).catch((e) => fail(e.message));

const ws = new WebSocket(wsUrl);
await new Promise((r, j) => {
  ws.onopen = r;
  ws.onerror = () => j(new Error("no DevTools connection"));
}).catch((e) => fail(e.message));
let nextId = 1;
const pending = new Map();
const listeners = [];
ws.onmessage = (ev) => {
  const msg = JSON.parse(ev.data);
  if (msg.id && pending.has(msg.id)) {
    const { resolve, reject } = pending.get(msg.id);
    pending.delete(msg.id);
    msg.error ? reject(new Error(msg.error.message)) : resolve(msg.result);
  } else if (msg.method) {
    for (const l of [...listeners]) l(msg);
  }
};
let session;
const send = (method, params = {}, s = session) =>
  new Promise((resolve, reject) => {
    const id = nextId++;
    pending.set(id, { resolve, reject });
    ws.send(JSON.stringify({ id, method, params, ...(s ? { sessionId: s } : {}) }));
  });
const once = (method, ms) =>
  new Promise((resolve) => {
    const timer = setTimeout(() => {
      listeners.splice(listeners.indexOf(l), 1);
      resolve(null);
    }, ms);
    const l = (m) => {
      if (m.method === method && m.sessionId === session) {
        clearTimeout(timer);
        listeners.splice(listeners.indexOf(l), 1);
        resolve(m);
      }
    };
    listeners.push(l);
  });
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
let lastStatus = "";

async function finish(code) {
  try {
    await send("Browser.close", {}, null);
  } catch {}
  await Promise.race([new Promise((r) => chrome.on("exit", r)), sleep(5000)]);
  chrome.kill("SIGKILL");
  process.exit(code);
}

try {
  const { targetId } = await send("Target.createTarget", { url: "about:blank" }, null);
  ({ sessionId: session } = await send("Target.attachToTarget", { targetId, flatten: true }, null));
  for (const d of ["Page", "Network", "Runtime", "DOM", "CSS", "Accessibility", "DOMSnapshot"]) await send(`${d}.enable`);
  await send("Page.setLifecycleEventsEnabled", { enabled: true });
  await metrics();
  if (js === "off") await send("Emulation.setScriptExecutionDisabled", { value: true });
  if (Number(slow) > 1) await send("Emulation.setCPUThrottlingRate", { rate: Number(slow) });

  // The viewer's signed-in cookie goes into the profile only when the profile
  // holds no cookie of that name yet, so a session the browser itself made
  // (the sign-in step) or ended (Sign out) stays as the browser left it.
  const held = new Set((await send("Network.getCookies", { urls: [base] })).cookies.map((c) => c.name));
  if (existsSync(jar)) {
    for (const line of readFileSync(jar, "utf8").split("\n")) {
      let l = line;
      let httpOnly = false;
      if (l.startsWith("#HttpOnly_")) {
        httpOnly = true;
        l = l.slice("#HttpOnly_".length);
      } else if (l.startsWith("#") || !l.trim()) continue;
      const f = l.split("\t");
      if (f.length < 7 || held.has(f[5])) continue;
      const c ={ name: f[5], value: f[6], url: base, path: f[2], httpOnly, secure: f[3] === "TRUE" };
      if (Number(f[4]) > 0) c.expires = Number(f[4]);
      await send("Network.setCookie", c);
    }
  }

  listeners.push((m) => {
    if (m.method === "Network.responseReceived" && m.params.type === "Document")
      lastStatus = `${m.params.response.status}`;
  });

  say(`browser: ${width}x${height}${mobile === "yes" ? " (phone)" : ""}, JavaScript ${js}` +
    (Number(slow) > 1 ? `, CPU slowed ${slow}x` : "") + ", this viewer's own browser profile");

  for (let i = 0; i < steps.length; i++) {
    const step = steps[i];
    const arg = () => {
      if (i + 1 >= steps.length) fail(`${step} needs a value`);
      return steps[++i];
    };
    switch (step) {
      case "go":
      case "watch-go": {
        let p = arg();
        if (p.startsWith("/") || p.includes("://")) fail("write the path without its leading slash");
        say(`\n> ${step} ${p}`);
        const frames = step === "watch-go" ? await watchStart() : null;
        lastStatus = "";
        const loaded = once("Page.loadEventFired", 20000);
        await send("Page.navigate", { url: `${base}/${p}` });
        await loaded;
        await settle(frames);
        break;
      }
      case "reload":
      case "watch-reload": {
        say(`\n> ${step}`);
        const frames = step === "watch-reload" ? await watchStart() : null;
        lastStatus = "";
        const loaded = once("Page.loadEventFired", 20000);
        await send("Page.reload", { ignoreCache: false });
        await loaded;
        await settle(frames);
        break;
      }
      case "key": {
        const k = arg();
        say(`\n> key ${k}`);
        const nav = once("Page.frameStartedLoading", 600);
        await key(k);
        await afterAction(nav);
        say("  " + (await focusLine()));
        break;
      }
      case "tab-order": {
        const n = Number(arg());
        if (!(n > 0 && n <= 80)) fail("tab-order takes 1 to 80");
        say(`\n> tab-order ${n}`);
        for (let t = 1; t <= n; t++) {
          await key("Tab");
          await sleep(80);
          say(`  Tab ${t}: ${await focusLine()}`);
        }
        break;
      }
      case "click": {
        const name = arg();
        say(`\n> click "${name}"`);
        const nav = once("Page.frameStartedLoading", 600);
        await click(name);
        await afterAction(nav);
        break;
      }
      case "hover": {
        const name = arg();
        say(`\n> hover "${name}"`);
        const n = await pick(name);
        const b = await boxOf(n);
        await send("Input.dispatchMouseEvent", { type: "mouseMoved", x: b.x + b.w / 2, y: b.y + b.h / 2 });
        await sleep(250);
        say(`  pointer on ${role(n)} "${nameOf(n)}" at ${Math.round(b.x + b.w / 2)},${Math.round(b.y + b.h / 2)}`);
        say("  " + (await textLine(n)));
        break;
      }
      case "sign-in": {
        say(`\n> sign-in`);
        lastStatus = "";
        let loaded = once("Page.loadEventFired", 20000);
        await send("Page.navigate", { url: `${base}/sign-in` });
        await loaded;
        await sleep(200);
        await type("Email", process.env.EXAMINE_EMAIL || "");
        await type("Password", process.env.EXAMINE_PASSWORD || "");
        say("  typed this viewer's email and password into the sign-in form");
        const nav = once("Page.frameStartedLoading", 3000);
        await key("Enter");
        await afterAction(nav);
        break;
      }
      case "width": {
        width = Number(arg());
        if (!(width >= 200 && width <= 3000)) fail("width takes 200 to 3000");
        say(`\n> width ${width}`);
        await metrics();
        await sleep(300);
        break;
      }
      case "look":
        say(`\n> look`);
        await look();
        break;
      default:
        fail(`no browser step named ${step}`);
    }
  }
  await finish(0);
} catch (e) {
  process.stderr.write("examine-foundry: " + e.message + "\n");
  await finish(1);
}

async function metrics() {
  await send("Emulation.setDeviceMetricsOverride", {
    width, height, deviceScaleFactor: 1, mobile: mobile === "yes",
  });
  if (mobile === "yes") await send("Emulation.setTouchEmulationEnabled", { enabled: true, maxTouchPoints: 5 });
}

async function key(k) {
  const table = {
    Tab: ["Tab", "Tab", 9, ""],
    "Shift+Tab": ["Tab", "Tab", 9, "", 8],
    Enter: ["Enter", "Enter", 13, "\r"],
    Space: [" ", "Space", 32, " "],
    Escape: ["Escape", "Escape", 27, ""],
  };
  const e = table[k];
  if (!e) fail(`key takes Tab, Shift+Tab, Enter, Space or Escape, not ${k}`);
  const [keyName, code, vk, text, modifiers = 0] = e;
  const common = { key: keyName, code, windowsVirtualKeyCode: vk, nativeVirtualKeyCode: vk, modifiers };
  await send("Input.dispatchKeyEvent", { type: text ? "keyDown" : "rawKeyDown", text: text || undefined, ...common });
  await send("Input.dispatchKeyEvent", { type: "keyUp", ...common });
}

// nav: a wait for a page load, begun before the action so none is missed.
async function afterAction(nav) {
  const started = await nav;
  if (started) {
    lastStatus = "";
    await once("Page.loadEventFired", 20000);
    await sleep(200);
    say(`  the page changed: ${await here()} (status ${lastStatus || "unknown"})`);
  } else await sleep(150);
}

async function settle(frames) {
  await sleep(frames ? 1200 : 300);
  say(`  page: ${await here()} (status ${lastStatus || "unknown"})`);
  if (frames) await watchReport(frames);
}

async function here() {
  const { result } = await send("Runtime.evaluate", { expression: "location.pathname + location.search", returnByValue: true })
    .catch(() => ({ result: {} }));
  if (result && result.value) return result.value;
  const t = await send("Target.getTargetInfo", {}, session).catch(() => null);
  return t ? new URL(t.targetInfo.url).pathname : "?";
}

// ---- paint frames: before each frame the browser paints, the probe notes where
// every navigation landmark and the main landmark are and how wide they are.
async function watchStart() {
  if (js === "off") fail("watch-go and watch-reload need JavaScript on (they sample before each painted frame)");
  const frames = [];
  const world = "examine-foundry-probe";
  await send("Runtime.addBinding", { name: "__examineFrame", executionContextName: world });
  const l = (m) => {
    if (m.method === "Runtime.bindingCalled" && m.params.name === "__examineFrame") frames.push(JSON.parse(m.params.payload));
  };
  listeners.push(l);
  const { identifier } = await send("Page.addScriptToEvaluateOnNewDocument", {
    worldName: world,
    source: `(() => {
      let n = 0;
      const box = (e) => { const r = e.getBoundingClientRect(); const s = getComputedStyle(e);
        return (s.display === "none" || s.visibility === "hidden" || r.width === 0) ? "hidden" : Math.round(r.left) + "+" + Math.round(r.width); };
      const snap = () => {
        const navs = [...document.querySelectorAll("nav, [role=navigation]")].map((e) =>
          (e.getAttribute("aria-label") || e.tagName.toLowerCase()) + " " + box(e));
        const main = document.querySelector("main, [role=main]");
        const side = [...document.querySelectorAll("aside, [role=complementary]")].map(box);
        __examineFrame(JSON.stringify({ t: Math.round(performance.now()), ready: document.readyState,
          navs: navs.length ? navs.join(" | ") : "no navigation landmark parsed yet",
          main: (main ? box(main) : "none parsed") + "; complementary: " + (side.length ? side.join(" | ") : "none parsed") }));
        if (++n < 400) requestAnimationFrame(snap);
      };
      requestAnimationFrame(snap);
    })();`,
  });
  frames.cleanup = async () => {
    listeners.splice(listeners.indexOf(l), 1);
    await send("Page.removeScriptToEvaluateOnNewDocument", { identifier });
  };
  return frames;
}

async function watchReport(frames) {
  await frames.cleanup();
  const { result } = await send("Runtime.evaluate", {
    expression: "JSON.stringify(performance.getEntriesByType('paint').map(p => p.name + ' at ' + Math.round(p.startTime) + ' ms'))",
    returnByValue: true,
  });
  say(`  paint timing: ${JSON.parse(result.value).join(", ") || "none reported"}`);
  say(`  frames sampled before paint: ${frames.length} (each row: the frames in a row with the same layout)`);
  let run = null;
  const flush = () => run && say(`    frames ${run.from}-${run.to} (${run.t0}-${run.t1} ms, ${run.ready}): navigation: ${run.navs}; main: ${run.main}`);
  frames.forEach((f, i) => {
    if (run && run.navs === f.navs && run.main === f.main) {
      run.to = i + 1;
      run.t1 = f.t;
      return;
    }
    flush();
    run = { from: i + 1, to: i + 1, t0: f.t, t1: f.t, ready: f.ready, navs: f.navs, main: f.main };
  });
  flush();
}

// ---- reading the page as it is now (no page JavaScript is used for this)
async function axTree() {
  const { nodes } = await send("Accessibility.getFullAXTree");
  const byId = new Map(nodes.map((n) => [n.nodeId, n]));
  return { nodes, byId };
}
function prop(n, name) {
  const p = (n.properties || []).find((p) => p.name === name);
  return p ? p.value.value : undefined;
}
async function boxOf(n) {
  if (!n.backendDOMNodeId) return null;
  try {
    const { model } = await send("DOM.getBoxModel", { backendNodeId: n.backendDOMNodeId });
    const q = model.border;
    const x = Math.min(q[0], q[6]), y = Math.min(q[1], q[3]);
    return { x: Math.round(x), y: Math.round(y), w: Math.round(model.width), h: Math.round(model.height) };
  } catch {
    return null;
  }
}
function shown(n, b) {
  if (n.ignored || !b || b.w === 0 || b.h === 0) return "hidden";
  if (b.x >= width || b.x + b.w <= 0) return "off-screen";
  return "visible";
}
function role(n) {
  return (n.role && n.role.value) || "?";
}
function nameOf(n) {
  return (n.name && n.name.value) || "";
}
function inside(n, byId, roles) {
  for (let p = byId.get(n.parentId); p; p = byId.get(p.parentId)) if (roles.includes(role(p))) return p;
  return null;
}

async function focusLine() {
  const { nodes } = await axTree();
  const f = nodes.filter((n) => prop(n, "focused") === true).pop();
  if (!f || role(f) === "RootWebArea") return "focus: on the page itself (no control has the focus)";
  const b = await boxOf(f);
  let ring = "";
  try {
    await send("DOM.getDocument", { depth: 0 });
    const { nodeIds } = await send("DOM.pushNodesByBackendIdsToFrontend", { backendNodeIds: [f.backendDOMNodeId] });
    const { computedStyle } = await send("CSS.getComputedStyleForNode", { nodeId: nodeIds[0] });
    const s = Object.fromEntries(computedStyle.map((c) => [c.name, c.value]));
    ring = ` focus ring: outline ${s["outline-style"]} ${s["outline-width"]} ${s["outline-color"]}, box-shadow ${s["box-shadow"]}`;
  } catch {}
  return `focus: ${role(f)} "${nameOf(f)}"${await currentOf(f)} ${b ? `at x=${b.x} w=${b.w}` : ""} ${shown(f, b)};${ring}\n    ${await textLine(f)}`;
}

// The page's own aria-current mark on a control, read from the DOM.
async function currentOf(n) {
  if (!n.backendDOMNodeId) return "";
  try {
    const { node } = await send("DOM.describeNode", { backendNodeId: n.backendDOMNodeId });
    const a = node.attributes || [];
    const i = a.indexOf("aria-current");
    return i >= 0 ? ` current=${a[i + 1]}` : "";
  } catch {
    return "";
  }
}

// The words a control paints, as a person sees them: each element inside it
// that holds its own text, with its box, and whether the point at the centre
// of that box shows that element (a word clipped away or covered shows
// something else there). It runs in a world of its own, apart from the page's
// scripts, and changes nothing.
async function textLine(n) {
  if (!n.backendDOMNodeId) return "words painted: unknown (no DOM node)";
  try {
    const { frameTree } = await send("Page.getFrameTree");
    const { executionContextId } = await send("Page.createIsolatedWorld", {
      frameId: frameTree.frame.id, worldName: "examine-foundry-reader",
    });
    const { object } = await send("DOM.resolveNode", { backendNodeId: n.backendDOMNodeId, executionContextId });
    const { result } = await send("Runtime.callFunctionOn", {
      objectId: object.objectId,
      returnByValue: true,
      functionDeclaration: `function () {
        const out = [];
        for (const e of [this, ...this.querySelectorAll("*")]) {
          const own = [...e.childNodes].filter((c) => c.nodeType === 3).map((c) => c.textContent).join("").trim();
          if (!own) continue;
          const r = e.getBoundingClientRect();
          const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
          const inView = cx >= 0 && cy >= 0 && cx < innerWidth && cy < innerHeight;
          const hit = inView ? document.elementFromPoint(cx, cy) : null;
          const seen = !inView ? "centre off-screen" : hit && (hit === e || e.contains(hit)) ? "seen" : "not seen at its centre (clipped or covered)";
          out.push('"' + own.slice(0, 40) + '" x=' + Math.round(r.left) + " w=" + Math.round(r.width) + " h=" + Math.round(r.height) + " " + seen);
        }
        return out.join("; ");
      }`,
    });
    return `words painted: ${result.value || "none"}`;
  } catch (e) {
    return `words painted: unknown (${e.message})`;
  }
}

// The one visible control with that accessible name (exact, else a part).
async function pick(name) {
  const { nodes } = await axTree();
  const clickable = nodes.filter((n) => !n.ignored && ["button", "link", "switch", "menuitem", "checkbox", "tab"].includes(role(n)));
  let hits = clickable.filter((n) => nameOf(n) === name);
  if (!hits.length) hits = clickable.filter((n) => nameOf(n).toLowerCase().includes(name.toLowerCase()));
  if (hits.length !== 1)
    fail(`${hits.length} visible controls are named like "${name}"${hits.length ? ": " + hits.map((n) => `"${nameOf(n)}"`).join(", ") : ""}`);
  await send("DOM.scrollIntoViewIfNeeded", { backendNodeId: hits[0].backendDOMNodeId }).catch(() => {});
  const b = await boxOf(hits[0]);
  if (!b || b.w === 0) fail(`"${nameOf(hits[0])}" has no box to point at`);
  return hits[0];
}

// Real typing into the one text field with that accessible name.
async function type(name, text) {
  const { nodes } = await axTree();
  const hits = nodes.filter((n) => !n.ignored && ["textbox", "searchbox"].includes(role(n)) && nameOf(n) === name);
  if (hits.length !== 1) fail(`${hits.length} text fields are named "${name}"`);
  await send("DOM.focus", { backendNodeId: hits[0].backendDOMNodeId });
  await send("Input.insertText", { text });
}

async function look() {
  const m = await send("Page.getLayoutMetrics");
  const vw = m.cssLayoutViewport.clientWidth, pw = Math.round(m.cssContentSize.width);
  say(`  page: ${await here()}`);
  say(`  viewport ${vw}x${m.cssLayoutViewport.clientHeight}; page ${pw} px wide; horizontal scroll: ${pw > vw ? "yes" : "no"}`);

  const snap = await send("DOMSnapshot.captureSnapshot", {
    computedStyles: ["overflow-x", "visibility", "display"],
    includeDOMRects: true,
  });
  const strings = snap.strings;
  const doc = snap.documents[0];
  const sideways = [], pastEdge = [];
  const nodeName = (i) => {
    const nm = strings[doc.nodes.nodeName[i]] || "?";
    const v = doc.nodes.nodeValue[i];
    return nm === "#text" && v >= 0 ? `text "${strings[v].trim().slice(0, 40)}"` : nm.toLowerCase();
  };
  doc.layout.nodeIndex.forEach((ni, li) => {
    const [x, , w, h] = doc.layout.bounds[li];
    const st = doc.layout.styles[li].map((s) => (s >= 0 ? strings[s] : ""));
    const sr = doc.layout.scrollRects && doc.layout.scrollRects[li];
    const cr = doc.layout.clientRects && doc.layout.clientRects[li];
    if (sr && cr && sr.length >= 4 && cr.length >= 4 && sr[2] > cr[2] + 1 && ["auto", "scroll"].includes(st[0]))
      sideways.push(`${nodeName(ni)} (${Math.round(cr[2])} px box, ${Math.round(sr[2])} px content)`);
    if (st[1] !== "hidden" && w > 0 && h > 0 && x + w > vw + 1) pastEdge.push(`${nodeName(ni)} (to x=${Math.round(x + w)})`);
  });
  say(`  boxes that scroll sideways inside the page: ${sideways.length ? sideways.slice(0, 10).join("; ") : "none"}`);
  say(`  boxes that reach past the right edge (a clipped box is listed too): ${pastEdge.length ? pastEdge.length + ": " + pastEdge.slice(0, 10).join("; ") : "none"}`);

  const { nodes, byId } = await axTree();
  const landmarks = ["navigation", "main", "banner", "complementary", "contentinfo"];
  say("  landmarks:");
  for (const n of nodes.filter((n) => landmarks.includes(role(n)))) {
    const b = await boxOf(n);
    say(`    ${role(n)} "${nameOf(n)}" ${b ? `x=${b.x} w=${b.w} y=${b.y} h=${b.h}` : "no box"} ${shown(n, b)}`);
  }
  say("  buttons:");
  for (const n of nodes.filter((n) => ["button", "switch", "menuitem"].includes(role(n)) || prop(n, "pressed") !== undefined)) {
    const b = await boxOf(n);
    const st = ["expanded", "pressed", "focusable"].map((p) => (prop(n, p) !== undefined ? `${p}=${prop(n, p)}` : "")).filter(Boolean);
    say(`    ${role(n)} "${nameOf(n)}" ${st.join(" ")} ${b ? `x=${b.x} w=${b.w}` : ""} ${shown(n, b)}`);
  }
  say("  links inside navigation landmarks:");
  let others = 0;
  for (const n of nodes.filter((n) => role(n) === "link")) {
    const nav = inside(n, byId, ["navigation"]);
    if (!nav) {
      others++;
      continue;
    }
    const b = await boxOf(n);
    say(`    [${nameOf(nav) || "navigation"}] link "${nameOf(n)}"${await currentOf(n)} ${b ? `x=${b.x} w=${b.w}` : ""} ${shown(n, b)}; ${await textLine(n)}`);
  }
  say(`  other links on the page: ${others}`);
  say("  " + (await focusLine()));
}

async function click(name) {
  const { nodes } = await axTree();
  const clickable = nodes.filter((n) => !n.ignored && ["button", "link", "switch", "menuitem", "checkbox", "tab"].includes(role(n)));
  let hits = clickable.filter((n) => nameOf(n) === name);
  if (!hits.length) hits = clickable.filter((n) => nameOf(n).toLowerCase().includes(name.toLowerCase()));
  if (hits.length !== 1)
    fail(`${hits.length} visible controls are named like "${name}"${hits.length ? ": " + hits.map((n) => `"${nameOf(n)}"`).join(", ") : ""}`);
  await send("DOM.scrollIntoViewIfNeeded", { backendNodeId: hits[0].backendDOMNodeId }).catch(() => {});
  const b = await boxOf(hits[0]);
  if (!b || b.w === 0) fail(`"${nameOf(hits[0])}" has no box to click`);
  const x = b.x + b.w / 2, y = b.y + b.h / 2;
  say(`  clicked ${role(hits[0])} "${nameOf(hits[0])}" at ${Math.round(x)},${Math.round(y)}`);
  await send("Input.dispatchMouseEvent", { type: "mouseMoved", x, y });
  await send("Input.dispatchMouseEvent", { type: "mousePressed", x, y, button: "left", clickCount: 1 });
  await send("Input.dispatchMouseEvent", { type: "mouseReleased", x, y, button: "left", clickCount: 1 });
}
JS
}

# ---- seeding through the public flows ----------------------------------------

expect() {
  local what="$1"
  shift
  local code
  for code in "$@"; do
    [ "$HTTP_CODE" = "$code" ] && return 0
  done
  die "seeding: $what answered $HTTP_STATUS at ${HTTP_FINAL:-?}"
}

expect_text() {
  local what="$1" text="$2"
  grep -qF -- "$text" "$STATE_DIR/last.body" || die "seeding: $what did not say \"$text\""
}

# Priya claims the first admin through the [BOOTSTRAP] link (which makes her the
# instance admin and an admin of the workspace), invites Tomás and Lena, who
# accept with a password; she creates team Backend, adds Lena and makes her
# lead, and creates the project Identity Platform.
seed_people_team_project() {
  local url
  url=$(grep -o '\[BOOTSTRAP\] Visit [^ ]* to claim admin' "$STATE_DIR/foundry.log" | head -n1 | cut -d' ' -f3)
  [ -n "$url" ] || die "seeding: the server log has no [BOOTSTRAP] link"
  local claim="${url#"$PUBLIC_URL"}"
  http priya GET "$claim"
  expect "the bootstrap link" 200
  http priya POST "$claim" "email=$(email_of priya)" "password=$PASSWORD" \
    "display_name=Priya Raman" "workspace_name=$WORKSPACE_NAME"
  expect "the bootstrap claim" 200
  has_session "$JARS/priya.txt" || die "seeding: the bootstrap claim did not sign Priya in"

  invite_and_accept tomas
  invite_and_accept lena

  # Workspace roles change only through the operator CLI, never the web tier.
  DATABASE_URL="$DATABASE_URL" timeout 60 "$STATE_DIR/bin/foundry" doctor set-role \
    --workspace "$WORKSPACE_NAME" --email "$(email_of tomas)" --role admin >/dev/null ||
    die "seeding: foundry doctor set-role could not make Tomás a workspace admin"

  # Direct SQL: an accepted invite names its person after the email's local part,
  # and no public flow changes a display name.
  psql_exec "UPDATE users SET display_name = 'Tomás Rivera' WHERE email_lower = '$(email_of tomas)';
             UPDATE users SET display_name = 'Lena Park' WHERE email_lower = '$(email_of lena)';"

  http priya POST /teams "name=Backend"
  expect "creating team Backend" 200
  http priya GET /team/backend/members
  expect "team Backend's members page" 200
  local lena_id
  lena_id=$(grep -o "<option value=\"[^\"]*\">[^<]*$(email_of lena)" "$STATE_DIR/last.body" |
    sed 's/^<option value="\([^"]*\)".*/\1/' | head -n1)
  [ -n "$lena_id" ] || die "seeding: team Backend's members page offers no Lena to add"
  http priya POST /team/backend/members "user_id=$lena_id"
  expect "adding Lena to Backend" 200
  http priya POST "/team/backend/members/$lena_id/role" "role=lead"
  expect "making Lena lead of Backend" 200
  http priya POST /team/backend/projects "name=Identity Platform" "key_prefix=AUTH"
  expect "creating Identity Platform" 200
  http lena GET /team/backend/project/identity-platform
  expect "Lena opening Identity Platform" 200
}

invite_and_accept() {
  local viewer="$1"
  http priya POST /workspace/invites "email=$(email_of "$viewer")"
  expect "inviting $viewer" 200
  accept_invite "$viewer"
}

# VIEWER accepts the invite link the last page showed.
accept_invite() {
  local viewer="$1" link
  link=$(grep -o "$PUBLIC_URL/invites/accept?[^\"<]*" "$STATE_DIR/last.body" | head -n1)
  [ -n "$link" ] || die "seeding: the invite page shows no accept link for $viewer"
  link=$(python3 -I -c 'import html,sys; print(html.unescape(sys.argv[1]))' "$link")
  local id sig
  id=$(python3 -I -c 'import sys,urllib.parse as u; print(u.parse_qs(u.urlsplit(sys.argv[1]).query)["id"][0])' "$link")
  sig=$(python3 -I -c 'import sys,urllib.parse as u; print(u.parse_qs(u.urlsplit(sys.argv[1]).query)["sig"][0])' "$link")
  http "$viewer" GET "${link#"$PUBLIC_URL"}"
  expect "$viewer opening the invite" 200
  http "$viewer" POST /invites/accept "id=$id" "sig=$sig" "password=$PASSWORD" "confirm=$PASSWORD"
  expect "$viewer accepting the invite" 200
  has_session "$JARS/$viewer.txt" || die "seeding: accepting the invite did not sign $viewer in"
}

psql_exec() {
  docker exec -i "$PG_NAME" psql -q -v ON_ERROR_STOP=1 -U postgres -d foundry -c "$1" >/dev/null ||
    die "seeding: SQL failed: $1"
}

instance_key_made() {
  [ -s "$(cat "$STATE_DIR/data-dir")/instance.key" ] ||
    die "seeding: Foundry made no instance key file in its data directory"
}

seed_secrets_key_no_slack() {
  instance_key_made
  generate_secrets_key
}

generate_secrets_key() {
  http priya POST /admin/instance/integrations/secrets-key
  expect "generating the secrets key" 200
  expect_text "generating the secrets key" "Secrets key generated."
}

seed_instance_key_no_secrets_key() {
  instance_key_made
}

env_env_slack_no_secrets_key() {
  printf '%s\n' "SLACK_CLIENT_ID=$SLACK_ID" "SLACK_CLIENT_SECRET=$SLACK_SECRET" \
    "SLACK_SIGNING_SECRET=$SLACK_SIGNING"
}

seed_env_slack_no_secrets_key() {
  instance_key_made
}

# VIEWER chooses Add to Slack on their workspace's integrations page; the
# double's approval screen approves the Slack workspace SLACK_TEAM and sends
# the browser back to Foundry.
connect_slack() {
  local viewer="$1" team="$2"
  printf '%s\n' "$team" >"$STATE_DIR/slack-next-team"
  http "$viewer" GET /workspace/integrations/slack/install
  expect "$viewer's Add to Slack" 200
  expect_text "$viewer's Add to Slack" "Connected to $team"
}

# Lena routes New issue on Identity Platform to #auth-dev through the
# route form, then creates an issue so one message is delivered.
seed_slack_route() {
  local form=/team/backend/project/identity-platform/integrations/routes
  http lena GET "$form/new?kind=slack"
  expect "Lena's Slack route form" 200
  expect_text "Lena's Slack route form" 'value="issue.created"'
  http lena POST "$form" kind=slack destination=C0AUTHDEV "channel_label.C0AUTHDEV=#auth-dev" \
    events=issue.created content_level=summary
  expect "Lena saving the Slack route" 200
  http lena POST /team/backend/project/identity-platform/issues "title=Rotate the signing key"
  expect "Lena creating an issue" 200
  local _
  for _ in $(seq 1 60); do
    grep -q '"method": "chat.postMessage"' "$STATE_DIR/slack-double.log" 2>/dev/null && return 0
    sleep 0.5
  done
  die "seeding: no message reached the Slack double within 30 seconds"
}

seed_slack_connected() {
  seed_slack_app_saved
  connect_slack priya "Canzan Labs"
  seed_slack_route
}

# Priya makes each workspace on the instance workspaces page, naming its first
# admin, who accepts the invite and connects it to Slack.
seed_slack_connected_three() {
  seed_slack_connected
  provision_and_connect "Ops Guild" omar "Omar Haddad"
  provision_and_connect "Reading Club" rosa "Rosa Lind"
}

provision_and_connect() {
  local workspace="$1" viewer="$2" name="$3"
  http priya POST /admin/instance/workspaces "name=$workspace" "email=$(email_of "$viewer")"
  expect "making the workspace $workspace" 200
  accept_invite "$viewer"
  # Direct SQL, as for Tomás and Lena: no public flow changes a display name.
  psql_exec "UPDATE users SET display_name = '$name' WHERE email_lower = '$(email_of "$viewer")';"
  connect_slack "$viewer" "$workspace"
}

env_env_slack_connected() {
  env_env_slack_no_secrets_key
}

seed_env_slack_connected() {
  seed_secrets_key_no_slack
  connect_slack priya "Canzan Labs"
}

# Priya invites Kai Tanaka to Canzan Labs and, once Kai accepts, makes Kai an
# instance admin with the instance workspaces page's grant form.
seed_second_instance_admin() {
  invite_and_accept kai
  psql_exec "UPDATE users SET display_name = 'Kai Tanaka' WHERE email_lower = '$(email_of kai)';"
  http priya GET /admin/instance/workspaces
  expect "the instance workspaces page" 200
  http priya POST /admin/instance/super-admins "email=$(email_of kai)"
  expect "making Kai an instance admin" 200
  local count
  count=$(docker exec "$PG_NAME" psql -q -At -U postgres -d foundry -c \
    "SELECT count(*) FROM instance_admins a JOIN users u ON u.id = a.user_id WHERE u.email_lower = '$(email_of kai)';")
  [ "$count" = 1 ] || die "seeding: Kai is not an instance admin after the grant"
}

seed_slack_app_awaiting_confirm() {
  seed_slack_connected
  seed_second_instance_admin
  http priya POST /admin/instance/integrations/slack "client_id=6123456789012.8888888888888" \
    "client_secret=$SLACK_SECRET" "signing_secret=$SLACK_SIGNING_ROTATED"
  expect "submitting another Slack app" 200
  case "$HTTP_FINAL" in
    /admin/instance/integrations/slack/confirm*) ;;
    *) die "seeding: submitting another Slack app ended at ${HTTP_FINAL:-?}, not its confirm page" ;;
  esac
}

seed_slack_delivery_pending() {
  seed_slack_connected
  slack_posting not-answering >/dev/null
  http lena POST /team/backend/project/identity-platform/issues "title=Expire the old sessions"
  expect "Lena creating an issue" 200
  local _
  for _ in $(seq 1 60); do
    grep -q '"answered": "HTTP 503' "$STATE_DIR/slack-double.log" 2>/dev/null && return 0
    sleep 0.5
  done
  die "seeding: Foundry did not try to post the second issue within 30 seconds"
}

seed_slack_app_saved() {
  seed_secrets_key_no_slack
  save_slack_app
}

save_slack_app() {
  http priya POST /admin/instance/integrations/slack "client_id=$SLACK_ID" \
    "client_secret=$SLACK_SECRET" "signing_secret=$SLACK_SIGNING"
  expect "saving the Slack app" 200
  expect_text "saving the Slack app" "Saved."
}

# ---- the secrets key Foundry cannot open, and the key file it cannot read ----

# The operator's instance key, as the states that set FOUNDRY_INSTANCE_KEY start.
env_operator_key() {
  printf 'FOUNDRY_INSTANCE_KEY=%s\n' "$(cat "$STATE_DIR/instance-key")"
}

env_secrets_key_unopenable() { env_operator_key; }
env_secrets_key_unopenable_live_server() { env_operator_key; }
env_three_credentials_key_opens() { env_operator_key; }

# Priya generates the secrets key, saves the Slack app and connects Canzan
# Labs to Slack; Canzan Labs then gets a Matrix connection with a bot token.
#
# Direct SQL for the Matrix connection: connecting Matrix checks the bot token
# at the homeserver over https, Foundry refuses loopback and trusts only the
# public certificate authorities, so no homeserver this probe can run is one
# Foundry may reach. The row is the one the connect form writes; its sealed
# token is the Canzan Labs Slack credential's sealed bytes, sealed under the
# stored secrets key and bound to another row, so it opens nowhere. That is
# what every credential is to a Foundry that cannot open the secrets key,
# which is the only state that uses this row.
seed_three_credentials_with_matrix() {
  generate_secrets_key
  save_slack_app
  connect_slack priya "Canzan Labs"
  psql_exec "INSERT INTO integration_connections
               (id, workspace_id, kind, state, external_id, bot_user_id, label, detail,
                sealed_credential, credential_saved_at, connected_by, connected_at)
             SELECT gen_random_uuid(), c.workspace_id, 'matrix', 'connected',
                    'https://matrix.example.org', '@foundry:example.org', 'matrix.example.org',
                    '@foundry:example.org', c.sealed_credential, now(), c.connected_by, now()
               FROM integration_connections c JOIN workspaces w ON w.id = c.workspace_id
              WHERE w.name = '$WORKSPACE_NAME' AND c.kind = 'slack' AND c.state = 'connected';"
  local count
  count=$(docker exec "$PG_NAME" psql -q -At -U postgres -d foundry -c \
    "SELECT count(*) FROM integration_connections WHERE sealed_credential IS NOT NULL;")
  [ "$count" = 2 ] || die "seeding: Canzan Labs holds $count connections, not its Slack and Matrix ones"
}

# Replica 1 restarts with a different FOUNDRY_INSTANCE_KEY, so the stored
# secrets key is sealed under an instance key it does not hold (I-26).
#
# FOUNDRY_INTEGRATIONS_RELOAD_MS is the product's default (5000) from here on,
# as an operator's deploy would run. A server counts as still opening the key
# while its last beat is no older than 40 seconds, so a state with no live
# opener waits that long for the old server's last beat to age out.
lose_the_instance_key() {
  restart_replica 1 "FOUNDRY_INSTANCE_KEY=$(cat "$STATE_DIR/instance-key-other")" \
    FOUNDRY_INTEGRATIONS_RELOAD_MS=5000
}

# await_instance_page TEXT WHAT: GET the instance integrations page as Priya
# (reading changes nothing) until it holds TEXT, for at most 75 seconds.
await_instance_page() {
  local text="$1" what="$2"
  for _ in $(seq 1 75); do
    http priya GET /admin/instance/integrations
    [ "$HTTP_CODE" = 200 ] && grep -qF -- "$text" "$STATE_DIR/last.body" && return 0
    sleep 1
  done
  die "seeding: the instance integrations page did not show $what within 75 seconds"
}

seed_secrets_key_unopenable() {
  seed_three_credentials_with_matrix
  lose_the_instance_key
  # The old server's last beat ages out of the gate's window (40 s).
  await_instance_page "secrets-key/start-over" "Start over"
}

env_secrets_key_unopenable_one() { env_operator_key; }
env_secrets_key_unopenable_none() { env_operator_key; }

# One saved credential, the Slack app; no workspace is connected.
seed_secrets_key_unopenable_one() {
  generate_secrets_key
  save_slack_app
  lose_the_instance_key
  await_instance_page "secrets-key/start-over" "Start over"
}

# The secrets key alone: nothing is saved under it.
seed_secrets_key_unopenable_none() {
  generate_secrets_key
  lose_the_instance_key
  await_instance_page "secrets-key/start-over" "Start over"
}

# Replica 2 starts while the key still opens, with the instance key that
# sealed it, and keeps running; then replica 1 loses the key.
seed_secrets_key_unopenable_live_server() {
  seed_three_credentials_with_matrix
  launch_foundry 2
  lose_the_instance_key
  await_instance_page "Another Foundry server still opens the secrets key" \
    "the sentence that another server still opens the key"
}

# Replica 1 restarts with no FOUNDRY_INSTANCE_KEY and its key file replaced by
# one that holds no key (I-31): the operator's lost or damaged file. Direct
# file write: the data directory is the operator's, and no flow of Foundry's
# changes it.
seed_instance_key_file_unreadable() {
  seed_slack_app_saved
  connect_slack priya "Canzan Labs"
  local file
  file="$(cat "$STATE_DIR/data-dir")/instance.key"
  stop_replica 1
  rm -f "$file"
  (umask 077 && printf 'this is not an instance key\n' >"$file")
  restart_replica 1
  await_instance_page "cannot read its instance key file" "that it cannot read its instance key file"
}

seed_three_credentials_key_opens() {
  generate_secrets_key
  save_slack_app
  connect_slack priya "Canzan Labs"
  seed_slack_route
  provision_and_connect "Ops Guild" omar "Omar Haddad"
}

env_three_credentials_one_damaged() { env_operator_key; }

# Direct SQL: no flow of Foundry's damages a stored credential. The last byte
# of Ops Guild's sealed Slack credential is flipped, so its seal no longer
# verifies; the config version is left alone, as damage would leave it.
seed_three_credentials_one_damaged() {
  seed_three_credentials_key_opens
  psql_exec "UPDATE integration_connections c
                SET sealed_credential = overlay(sealed_credential placing
                    set_byte('\\x00'::bytea, 0, get_byte(sealed_credential, length(sealed_credential) - 1) # 1)
                    from length(sealed_credential))
               FROM workspaces w
              WHERE w.id = c.workspace_id AND w.name = 'Ops Guild' AND c.kind = 'slack';"
}

vm_main() {
  vm_dirs
  local op="$1"
  shift
  case "$op" in
    start) vm_start "$@" ;;
    build-before) vm_build_before "$@" ;;
    stop) vm_stop ;;
    slack-info) vm_require_running && slack_info ;;
    browser) vm_browser "$@" ;;
    slack-event)
      vm_require_running
      use_replica "$1"
      shift
      slack_event "$@"
      ;;
    slack-posting) vm_require_running && slack_posting "$1" ;;
    mail) vm_require_running && mail_print ;;
    rotate-secrets) vm_require_running && rotate_secrets ;;
    time-passes) vm_require_running && time_passes "$1" ;;
    contributor) vm_contributor "$@" ;;
    get)
      use_replica "$1"
      vm_request GET "$2" "$3"
      ;;
    post)
      use_replica "$1"
      local viewer="$2" path="$3"
      shift 3
      vm_request POST "$viewer" "$path" "$@"
      ;;
    *) die "unknown VM operation $op" ;;
  esac
}

main() {
  if [ "${1:-}" = __vm ]; then
    shift
    # In the VM, stdin is this script's own text: no child may read it.
    vm_main "$@" </dev/null
    return
  fi
  HOME=$(real_home)
  export HOME
  TMPDIR_HOST="${TMPDIR:-/tmp}"
  export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
  command -v timeout >/dev/null || die "timeout is not installed"
  SELF=$(self_path)
  ROOT=$(dirname "$(dirname "$SELF")")
  # Nothing below reads the caller's stdin (in_vm feeds the VM this script).
  host_main "$@" </dev/null
}

main "$@"
exit
